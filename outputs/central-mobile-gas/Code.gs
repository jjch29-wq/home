    class=\"rtk-inp w-full bg-slate-50 border border-slate-200 rounded-lg p-1.5 text-xs font-bold text-center\">\n        </div>\n        <div>\n          <label class=\"block text-[11px] text-purple-600 font-bold mb-0.5\">RTK 총계</label>\n          <input type=\"number\" id=\"rtk-total\" readonly value=\"0\"\n            class=\"w-full bg-purple-50 border border-purple-200 rounded-lg p-1.5 text-xs font-black text-purple-900 text-center\">\n        </div>\n      </div>\n    </div>\n\n    <!-- 5. [PT / MT 전용] NDT 자재 소모량 카드 -->\n    <div id=\"chemicals-card\" class=\"hidden bg-white rounded-2xl shadow-sm border border-slate-200/80 p-4 space-y-3\">\n      <div class=\"flex items-center justify-between border-b border-slate-100 pb-2\">\n        <span class=\"text-xs font-bold uppercase tracking-wider text-amber-700 flex items-center gap-1\">\n          <i data-lucide=\"flask-conical\" class=\"w-4 h-4\"></i> NDT 자재 소모량 (7종 약품)\n        </span>\n        <span class=\"text-[11px] text-slate-400\">캔(CAN) / 개수 기입</span>\n      </div>\n\n      <div class=\"grid grid-cols-2 gap-2\">\n        <div class=\"p-2 bg-slate-50 rounded-xl border border-slate-200/70\">\n          <span class=\"text-[11px] font-bold text-slate-700 block mb-1\">형광자분</span>\n          <input type=\"number\" id=\"chem-fl-mag\" min=\"0\" step=\"0.5\" placeholder=\"0\"\n            class=\"w-full bg-white border border-slate-200 rounded-lg px-2 py-1 text-xs font-bold text-center\">\n        </div>\n        <div class=\"p-2 bg-slate-50 rounded-xl border border-slate-200/70\">\n          <span class=\"text-[11px] font-bold text-slate-700 block mb-1\">흑색자분</span>\n          <input type=\"number\" id=\"chem-black-mag\" min=\"0\" step=\"0.5\" placeholder=\"0\"\n            class=\"w-full bg-white border border-slate-200 rounded-lg px-2 py-1 text-xs font-bold text-center\">\n        </div>\n        <div class=\"p-2 bg-slate-50 rounded-xl border border-slate-200/70\">\n          <span class=\"text-[11px] font-bold text-slate-700 block mb-1\">백색페인트</span>\n          <input type=\"number\" id=\"chem-white-paint\" min=\"0\" step=\"0.5\" placeholder=\"0\"\n            class=\"w-full bg-white border border-slate-200 rounded-lg px-2 py-1 text-xs font-bold text-center\">\n        </div>\n        <div class=\"p-2 bg-slate-50 rounded-xl border border-slate-200/70\">\n          <span class=\"text-[11px] font-bold text-slate-700 block mb-1\">침투제</span>\n          <input type=\"number\" id=\"chem-penetrant\" min=\"0\" step=\"0.5\" placeholder=\"0\"\n            class=\"w-full bg-white border border-slate-200 rounded-lg px-2 py-1 text-xs font-bold text-center\">\n        </div>\n        <div class=\"p-2 bg-slate-50 rounded-xl border border-slate-200/70\">\n          <span class=\"text-[11px] font-bold text-slate-700 block mb-1\">세척제</span>\n          <input type=\"number\" id=\"chem-cleaner\" min=\"0\" step=\"0.5\" placeholder=\"0\"\n            class=\"w-full bg-white border border-slate-200 rounded-lg px-2 py-1 text-xs font-bold text-center\">\n        </div>\n        <div class=\"p-2 bg-slate-50 rounded-xl border border-slate-200/70\">\n          <span class=\"text-[11px] font-bold text-slate-700 block mb-1\">현상제</span>\n          <input type=\"number\" id=\"chem-developer\" min=\"0\" step=\"0.5\" placeholder=\"0\"\n            class=\"w-full bg-white border border-slate-200 rounded-lg px-2 py-1 text-xs font-bold text-center\">\n        </div>\n        <div class=\"p-2 bg-slate-50 rounded-xl border border-slate-200/70\">\n          <span class=\"text-[11px] font-bold text-slate-700 block mb-1\">형광침투제</span>\n          <input type=\"number\" id=\"chem-fl-pen\" min=\"0\" step=\"0.5\" placeholder=\"0\"\n            class=\"w-full bg-white border border-slate-200 rounded-lg px-2 py-1 text-xs font-bold text-center\">\n        </div>\n      </div>\n    </div>\n\n    <!-- 6. [PAUT 전용] 가이드 안내 카드 -->\n    <div id=\"paut-guide-card\" class=\"bg-blue-50/80 rounded-2xl border border-blue-200 p-3.5 