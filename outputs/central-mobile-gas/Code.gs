 text-[10px] text-slate-500 mb-0.5\">핫태핑 개소</label>\n            <input type=\"number\" id=\"hottap-joints\" value=\"1\" min=\"1\" step=\"1\"\n              class=\"w-full bg-white border border-amber-300 rounded-lg p-1.5 text-xs font-bold text-center\">\n          </div>\n          <div>\n            <label class=\"block text-[10px] text-slate-500 mb-0.5\">핫태핑 관경</label>\n            <input type=\"text\" id=\"hottap-pipe\" placeholder=\"예: 250A\"\n              class=\"w-full bg-white border border-amber-300 rounded-lg p-1.5 text-xs font-bold\">\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- 2. 검사 방법 및 품명/자재 정보 카드 -->\n    <div class=\"bg-white rounded-2xl shadow-sm border border-slate-200/80 p-4 space-y-3\">\n      <div class=\"flex items-center justify-between border-b border-slate-100 pb-2\">\n        <span class=\"text-xs font-bold uppercase tracking-wider text-blue-700 flex items-center gap-1\">\n          <i data-lucide=\"layers\" class=\"w-4 h-4\"></i> 검사 방법 및 품명·자재\n        </span>\n      </div>\n\n      <!-- Segmented Method Buttons (PAUT 기본) -->\n      <div>\n        <label class=\"block text-xs font-medium text-slate-500 mb-1.5\">검사 방법 (Method)</label>\n        <div class=\"grid grid-cols-4 gap-1.5 p-1 bg-slate-100 rounded-xl\" id=\"method-buttons\">\n          <button type=\"button\" data-method=\"PAUT\"\n            class=\"method-btn py-2 text-xs font-bold rounded-lg bg-blue-600 text-white shadow-sm transition\">PAUT</button>\n          <button type=\"button\" data-method=\"RT\"\n            class=\"method-btn py-2 text-xs font-bold rounded-lg text-slate-600 hover:bg-white transition\">RT</button>\n          <button type=\"button\" data-method=\"MT\"\n            class=\"method-btn py-2 text-xs font-bold rounded-lg text-slate-600 hover:bg-white transition\">MT</button>\n          <button type=\"button\" data-method=\"PT\"\n            class=\"method-btn py-2 text-xs font-bold rounded-lg text-slate-600 hover:bg-white transition\">PT</button>\n        </div>\n      </div>\n\n      <!-- 검사품명 -->\n      <div>\n        <div class=\"flex items-center justify-between mb-1\">\n          <label class=\"block text-xs font-bold text-slate-700\">검사품명 (Item Name)</label>\n          <button type=\"button\" id=\"btn-toggle-custom-item\"\n            class=\"text-[11px] text-blue-600 font-semibold hover:underline\">\n            ✏️ 직접 입력\n          </button>\n        </div>\n        <select id=\"select-item-name\"\n          class=\"w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-sm font-semibold text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500\">\n          <option value=\"Pipe\" selected>Pipe</option>\n          <option value=\"Piping\">Piping</option>\n          <option value=\"Tank\">Tank</option>\n          <option value=\"Vessel\">Vessel</option>\n          <option value=\"Plate\">Plate</option>\n          <option value=\"Beam\">Beam</option>\n          <option value=\"Structure\">Structure</option>\n          <option value=\"기타\">기타</option>\n        </select>\n        <input type=\"text\" id=\"input-custom-item\" placeholder=\"검사품명 직접 입력\"\n          class=\"hidden mt-1.5 w-full bg-amber-50 border border-amber-300 rounded-xl px-3 py-2 text-sm font-semibold text-slate-800\">\n      </div>\n\n      <!-- 자재명 (RT 필름 / 약품) -->\n      <div id=\"material-input-wrap\" class=\"hidden\">\n        <div class=\"flex items-center justify-between mb-1\">\n          <label class=\"block text-xs font-bold text-slate-700\">자재명 (소모 필름 / 자재)</label>\n          <button type=\"button\" id=\"btn-toggle-custom-mat\"\n            class=\"text-[11px] text-blue-600 font-semibold hover:underline\">\n            ✏️ 직접 입력\n          </button>\n        </div>\n        <select id=\"select-material\"\n          class=\"w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-semibold text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500\">\n          <!-- Populated via JS -->\n        </select>\n        <input type=\"text\" id=\"input-custom-mat\" placeholder=\"자재명 직접 입력\"\n          class=\"hidden mt-1.5 w-full bg-amber-50 border border-amber-300 rounded-xl px-3 py-2 text-xs font-semibold text-slate-800\">\n        <p id=\"material-history-notice\" class=\"hidden mt-1.5 text-[10px] text-amber-700\">과거 기록에 저장된 자재명을 보존하여 표시합니다.</p>\n      </div>\n\n      <!-- 적용코드 & 성적서번호 -->\n      <div class=\"grid grid-cols-2 gap-2\">\n        <div>\n          <label class=\"block text-xs font-medium text-slate-500 mb-1\">적용코드 (Code)</label>\n          <select id=\"select-applied-code\"\n            class=\"w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-semibold text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500\">\n            <option value=\"지역난방시방서\" selected>지역난방시방서</option>\n            <option value=\"KS\">KS</option>\n            <option value=\"ASME\">ASME</option>\n            <option value=\"AWS\">AWS</option>\n            <option value=\"API\">API</option>\n            <option value=\"KEPIC\">KEPIC</option>\n            <option value=\"기타\">기타</option>\n          </select>\n        </div>\n        <div>\n          <label class=\"block text-xs font-medium text-slate-500 mb-1\">성적서번호</label>\n          <input type=\"text\" id=\"input-report-no\" placeholder=\"성적서번호 기입\"\n            class=\"w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-semibold text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500\">\n        </div>\n      </div>\n    </div>\n\n    <!-- 3. 검사 물량 및 단가 산정 카드 -->\n    <div class=\"bg-white rounded-2xl shadow-sm border border-slate-200/80 p-4 space-y-3\">\n      <div class=\"flex items-center justify-between border-b border-slate-100 pb-2\">\n        <span class=\"text-xs font-bold uppercase tracking-wider text-blue-700 flex items-center gap-1\">\n          <i data-lucide=\"calculator\" class=\"w-4 h-4\"></i> 검사 물량 및 단가 산정\n        </span>\n        <button type=\"button\" id=\"btn-toggle-pipe-calc\"\n          class=\"text-xs font-bold px-2 py-1 bg-blue-50 text-blue-700 border border-blue-200 rounded-lg hover:bg-blue-100 transition flex items-center gap-1\">\n          <i data-lucide=\"sliders-horizontal\" class=\"w-3.5 h-3.5\"></i>\n          <span id=\"pipe-calc-btn-text\">배관 관경 계산기</span>\n        </button>\n      </div>\n\n      <!-- 배관 관경 자동 계산 영역 -->\n      <div id=\"pipe-calc-section\" class=\"p-3 bg-slate-50/80 border border-slate-200/90 rounded-xl space-y-2.5\">\n        <div class=\"flex items-center justify-between\">\n          <span class=\"text-xs font-extrabold text-slate-700 flex items-center gap-1\">\n            <i data-lucide=\"git-commit\" class=\"w-3.5 h-3.5 text-blue-600\"></i> 배관 관경(Size) 및 조인트수\n          </span>\n          <span class=\"text-[10px] text-blue-700 font-semibold bg-blue-100 px-1.5 py-0.5 rounded\">지역난방 표준 환산</span>\n        </div>\n\n        <div>\n          <label class=\"block text-[11px] font-medium text-slate-500 mb-1\">배관 관경(Size)</label>\n          <select id=\"select-pipe\"\n            class=\"w-full bg-white border border-slate-200 rounded-xl px-3 py-2 text-sm font-semibold text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500\">\n            <option value=\"1100A\">1100A</option>\n            <option value=\"1000A\">1000A</option>\n            <option value=\"900A\">900A</option>\n            <option value=\"850A\">850A</option>\n            <option value=\"800A\">800A</option>\n            <option value=\"750A\">750A</option>\n            <option value=\"700A\">700A</option>\n            <option value=\"650A\">650A</option>\n            <option value=\"600A\">600A</option>\n            <option value=\"550A\">550A</option>\n            <option value=\"500A\">500A</option>\n            <option value=\"450A\">450A</option>\n            <option value=\"400A\">400A</option>\n            <option value=\"350A\">350A</option>\n            <option value=\"300A\">300A</option>\n            <option value=\"250A\" selected>250A</option>\n            <option value=\"200A\">200A</option>\n            <option value=\"150A\">150A</option>\n            <option value=\"125A\">125A</option>\n            <option value=\"100A\">100A</option>\n            <option value=\"80A\">80A</option>\n            <option value=\"65A\">65A</option>\n            <option value=\"50A\">50A</option>\n            <option value=\"40A\">40A</option>\n            <option value=\"32A\">32A</option>\n            <option value=\"25A\">25A</option>\n            <option value=\"20A\">20A</option>\n          </select>\n        </div>\n\n        <div id=\"rt-joints-box\" class=\"space-y-2 pt-0.5 hidden\">\n          <div class=\"grid grid-cols-2 gap-2\">\n            <div>\n              <label class=\"block text-[11px] font-medium text-slate-500 mb-0.5\">[ORI] 조인트수</label>\n              <input type=\"number\" id=\"input-ori-joints\" value=\"1\" min=\"0\" step=\"1\"\n                class=\"w-full bg-white border border-slate-200 rounded-xl px-3 py-1.5 text-xs font-bold text-slate-800\">\n            </div>\n            <div>\n              <label class=\"block text-[11px] font-medium text-slate-500 mb-0.5\">[REP] 조인트수</label>\n              <input type=\"number\" id=\"input-rep-joints\" value=\"0\" min=\"0\" step=\"1\"\n                class=\"w-full bg-white border border-slate-200 rounded-xl px-3 py-1.5 text-xs font-bold text-slate-800\">\n            </div>\n          </div>\n          <div>\n            <label class=\"block text-[11px] font-medium text-slate-500 mb-0.5\">당일 불량(REJ)수 (RT: 매)</label>\n            <input type=\"number\" id=\"input-rej-qty\" value=\"0\" min=\"0\" step=\"1\"\n              class=\"w-full bg-white border border-slate-200 rounded-xl px-3 py-1.5 text-xs font-bold text-slate-800\">\n          </div>\n        </div>\n\n        <div id=\"non-rt-joints-box\">\n          <label class=\"block text-[11px] font-medium text-slate-500 mb-0.5\">조인트수 (개소)</label>\n          <input type=\"number\" id=\"input-joints\" value=\"1\" min=\"0.1\" step=\"0.5\"\n            class=\"w-full bg-white border border-slate-200 rounded-xl px-3 py-1.5 text-xs font-bold text-slate-800\">\n        </div>\n      </div>\n\n      <div id=\"non-pipe-banner\"\n        class=\"hidden p-2.5 bg-blue-50/80 border border-blue-200 rounded-xl text-xs text-blue-800 flex items-center justify-between\">\n        <span class=\"font-bold\">💡 비배관(탱크/용기/철골) 직접 입력 모드</span>\n        <span class=\"text-[10px] text-blue-600\">수량·단위·단가를 직접 기입하세요</span>\n      </div>\n\n      <!-- 공통 수량 및 단위 -->\n      <div class=\"grid grid-cols-2 gap-2 pt-1\">\n        <div>\n          <label class=\"block text-xs font-bold text-slate-700 mb-1\">검사 수량 (물량)</label>\n          <input type=\"number\" id=\"input-qty\" value=\"0.8401\" min=\"0\" step=\"0.0001\"\n            class=\"w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-base font-black text-blue-950 focus:outline-none focus:ring-2 focus:ring-blue-500\">\n        </div>\n        <div>\n          <label class=\"block text-xs font-bold text-slate-700 mb-1\">단위 (Unit)</label>\n          <select id=\"select-unit\"\n            class=\"w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-sm font-bold text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500\">\n            <option value=\"M\" selected>M</option>\n            <option value=\"매\">매</option>\n            <option value=\"EA\">EA</option>\n            <option value=\"P,M,I/D\">P,M,I/D</option>\n            <option value=\"Point\">Point</option>\n            <option value=\"SET\">SET</option>\n            <option value=\"CAN\">CAN</option>\n            <option value=\"KG\">KG</option>\n            <option value=\"Inch\">Inch</option>\n          </select>\n        </div>\n      </div>\n\n      <!-- 단가 / 출장비 / 일식 -->\n      <div class=\"grid grid-cols-3 gap-2\">\n        <div>\n          <label class=\"block text-[11px] font-medium text-slate-500 mb-1\">단가 (원)</label>\n          <input type=\"number\" id=\"input-unit-price\" value=\"325451\" min=\"0\" step=\"100\"\n            class=\"w-full bg-slate-50 border border-slate-200 rounded-xl px-2 py-1.5 text-xs font-bold text-slate-800\">\n        </div>\n        <div>\n          <label class=\"block text-[11px] font-medium text-slate-500 mb-1\">출장비 (원)</label>\n          <input type=\"number\" id=\"input-travel-cost\" value=\"0\" min=\"0\" step=\"1000\"\n            class=\"w-full bg-slate-50 border border-slate-200 rounded-xl px-2 py-1.5 text-xs font-bold text-slate-800\">\n        </div>\n        <div>\n          <label class=\"block text-[11px] font-medium text-slate-500 mb-1\">일식</label>\n          <input type=\"text\" id=\"input-lump-sum\" placeholder=\"식대/일식\"\n            class=\"w-full bg-slate-50 border border-slate-200 rounded-xl px-2 py-1.5 text-xs font-bold text-slate-800\">\n        </div>\n      </div>\n\n      <!-- Total Fee Box -->\n      <div\n        class=\"p-3 bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-200 rounded-xl flex items-center justify-between\">\n        <div>\n          <p class=\"text-xs text-blue-800 font-bold\">총 검사비 (수량×단가+출장비)</p>\n          <p class=\"text-[10px] text-blue-600\">제경비 110%, 기술료 20% 계약단가 기준</p>\n        </div>\n        <div class=\"flex items-center gap-1.5\">\n          <input type=\"number\" id=\"input-total-fee\" value=\"273411\"\n            class=\"w-32 bg-white border border-blue-300 rounded-lg px-2 py-1 text-right text-base font-black text-blue-950 focus:outline-none focus:ring-2 focus:ring-blue-500\">\n          <span class=\"text-xs font-bold text-blue-900\">원</span>\n        </div>\n      </div>\n\n      <!-- Equipments -->\n      <div class=\"grid grid-cols-2 gap-2 pt-1 border-t border-slate-100\">\n        <div id=\"main-equipment-wrap\">\n          <label class=\"block text-[11px] font-medium text-slate-500 mb-1\">주 장비</label>\n          <select id=\"select-equip\" multiple\n            class=\"w-full bg-slate-50 border border-slate-200 rounded-xl px-2 py-1.5 text-xs text-slate-800 focus:outline-none\">\n            <option value=\"PAUT MX2(OMNI2-103085)\" selected>PAUT MX2(OMNI2-103085)</option>\n            <option value=\"Se-75\">Se-75</option>\n            <option value=\"Yoke\">Yoke</option>\n            <option value=\"PT 약품\">PT 약품</option>\n          </select>\n        </div>\n        <div id=\"aux-equipment-wrap\">\n          <label id=\"aux-equipment-label\" class=\"block text-[11px] font-medium text-slate-500 mb-1\">보조 장비/스캐너</label>\n          <select id=\"select-aux-equip\" multiple onchange=\"checkCustomAux()\"\n            class=\"w-full bg-slate-50 border border-slate-200 rounded-xl px-2 py-1.5 text-xs text-slate-800 focus:outline-none\">\n            <option value=\"PAUT SCANNER (MANUAL)\" selected>PAUT SCANNER (MANUAL)</option>\n            <option value=\"COBRA Manual Scanner\">COBRA Manual Scanner</option>\n            <option value=\"JIREH MICROBE BTG006\">JIREH MICROBE BTG006</option>\n            <option value=\"JIREH Scanner\">JIREH Scanner</option>\n            <option value=\"ADR, SURVEY, 콜리메타\">ADR, SURVEY, 콜리메타</option>\n            <option value=\"ADR\">ADR</option>\n            <option value=\"SURVEY\">SURVEY</option>\n            <option value=\"콜리메타\">콜리메타</option>\n            <option value=\"자분살포기\">자분살포기</option>\n            <option value=\"조도계\">조도계</option>\n            <option value=\"자계강도계\">자계강도계</option>\n            <option value=\"온습도계\">온습도계</option>\n            <option value=\"휴대용 UV메타\">휴대용 UV메타</option>\n            <option value=\"없음\">없음</option>\n            <option value=\"✏️ 직접 입력...\">✏️ 직접 입력...</option>\n          </select>\n          <input type=\"text\" id=\"input-custom-aux\" placeholder=\"직접 보조장비 입력\"\n            class=\"hidden mt-1.5 w-full bg-amber-50 border border-amber-300 rounded-xl px-2.5 py-1 text-xs text-slate-800\">\n        </div>\n        <div id=\"paut-equipment-grid\"\n          class=\"hidden col-span-2 grid grid-cols-1 sm:grid-cols-3 gap-2 pt-2 border-t border-blue-100\">\n          <div>\n            <label class=\"block text-[11px] font-bold text-blue-700 mb-1\">1. 스캐너</label>\n            <select id=\"select-paut-scanner\" multiple\n              class=\"w-full bg-blue-50 border border-blue-200 rounded-xl px-2 py-1.5 text-xs text-slate-800 focus:outline-none\"></select>\n          </div>\n          <div>\n            <label class=\"block text-[11px] font-bold text-blue-700 mb-1\">2. 탐촉자</label>\n            <select id=\"select-paut-probe\" multiple\n              class=\"w-full bg-blue-50 border border-blue-200 rounded-xl px-2 py-1.5 text-xs text-slate-800 focus:outline-none\"></select>\n          </div>\n          <div>\n            <label class=\"block text-[11px] font-bold text-blue-700 mb-1\">3. 웻지</label>\n            <select id=\"select-paut-wedge\" multiple\n              class=\"w-full bg-blue-50 border border-blue-200 rounded-xl px-2 py-1.5 text-xs text-slate-800 focus:outline-none\"></select>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- 4. [RT 전용] RTK 결함 분류 카드 -->\n    <div id=\"rtk-card\" class=\"hidden bg-white rounded-2xl shadow-sm border border-slate-200/80 p-4 space-y-3\">\n      <div class=\"flex items-center justify-between border-b border-slate-100 pb-2\">\n        <span class=\"text-xs font-bold uppercase tracking-wider text-purple-700 flex items-center gap-1\">\n          <i data-lucide=\"scan-line\" class=\"w-4 h-4\"></i> RTK 결함 분류 (RT 매수)\n        </span>\n        <span class=\"text-xs font-bold text-purple-700\">총계: <span id=\"rtk-total-badge\">0</span> 매</span>\n      </div>\n\n      <div class=\"grid grid-cols-3 gap-2\">\n        <div>\n          <label class=\"block text-[11px] text-slate-500 mb-0.5\">센터미스</label>\n          <input type=\"number\" id=\"rtk-center-miss\" min=\"0\" step=\"1\" placeholde