\", \"SET\", \"CAN\", \"KG\", \"Inch\", \"Dia\", \"I/D\"],\n      test_items: [\"Pipe\", \"Piping\", \"Tank\", \"Vessel\", \"Plate\", \"Beam\", \"Structure\", \"기타\"],\n      applied_codes: [\"지역난방시방서\", \"KS\", \"ASME\", \"AWS\", \"API\", \"KEPIC\", \"기타\"],\n      materials: [\n        'Carestream AA400-3⅓*12\"', 'Carestream AA400-3⅓*17\"', 'Carestream AA400-4½*12\"',\n        'Carestream AA400-10*12\"', 'Carestream M100-3⅓*12\"', 'Carestream M100-10*12\"',\n        'Carestream M100-14*17\"', 'Carestream MX125-3⅓*6\"', 'Carestream MX125-3⅓*12\"',\n        'Carestream MX125-4½*12\"', 'Carestream MX125-10*12\"', 'Carestream MX125-14*17\"',\n        'Carestream T200-3⅓*12\"', 'Carestream T200-3⅓*17\"', 'Carestream T200-4½*12\"',\n        'Carestream T200-10*12\"', 'Carestream T200-14*17\"'\n      ],\n      worktimes: [\n        \"09:00~18:00\", \"09:00~19:00\", \"09:00~20:00\", \"09:00~21:00\", \"09:00~22:00\",\n        \"09:00~23:00\", \"09:00~24:00\", \"09:00~익일01:00\", \"09:00~익일02:00\", \"09:00~익일03:00\",\n        \"09:00~익일04:00\", \"09:00~익일05:00\", \"09:00~익일06:00\", \"09:00~익일07:00\", \"09:00~익일08:00\", \"09:00~익일09:00\",\n        \"10:00~17:00\", \"10:00~19:00\", \"12:00~익일08:00\", \"13:00~22:00\", \"13:00~익일02:00\",\n        \"18:00~익일01:00\", \"18:00~익일02:00\", \"18:00~익일03:00\", \"18:00~익일04:00\", \"18:00~익일05:00\", \"18:00~익일06:00\", \"18:00~익일07:00\", \"18:00~익일08:00\",\n        \"20:00~익일02:00\", \"20:00~익일04:00\", \"20:00~익일05:00\", \"20:00~익일06:00\",\n        \"21:00~익일03:00\", \"21:00~익일05:00\", \"21:00~익일06:00\", \"21:00~익일07:00\",\n        \"22:00~익일01:00\", \"22:00~익일02:00\", \"22:00~익일03:00\", \"22:00~익일04:00\", \"22:00~익일05:00\", \"22:00~익일06:00\", \"22:00~익일07:00\", \"22:00~익일08:00\", \"22:00~익일09:00\"\n      ]\n    };\n\n    let appConfig = Object.assign({}, DEFAULT_CONFIG);\n    let selectedMethod = \"PAUT\";\n    let workerRows = [];\n    let isPipeCalcOpen = true;\n    let isManualQty = false;\n\n    const dateInput = document.getElementById(\"input-date\");\n    dateInput.value = new Date().toISOString().split(\"T\")[0];\n\n    function showToast(msg, isError = false) {\n      const toast = document.getElementById(\"toast\");\n      const msgEl = document.getElementById(\"toast-msg\");\n      msgEl.textContent = msg;\n      toast.className = `fixed bottom-6 left-1/2 -translate-x-1/2 z-50 px-4 py-3 rounded-2xl ${isError ? 'bg-rose-800' : 'bg-slate-900'} text-white text-xs font-semibold shadow-2xl transition-all duration-300 opacity-100 pointer-events-auto flex items-center gap-2`;\n      setTimeout(() => {\n        toast.className = toast.className.replace('opacity-100', 'opacity-0').replace('pointer-events-auto', 'pointer-events-none');\n      }, 2500);\n    }\n\n    // Toggle custom inputs\n    document.getElementById(\"btn-toggle-custom-item\").addEventListener(\"click\", () => {\n      const inp = document.getElementById(\"input-custom-item\");\n      inp.classList.toggle(\"hidden\");\n      if (!inp.classList.contains(\"hidden\")) inp.focus();\n    });\n\n    document.getElementById(\"btn-toggle-custom-mat\").addEventListener(\"click\", () => {\n      const inp = document.getElementById(\"input-custom-mat\");\n      inp.classList.toggle(\"hidden\");\n      if (!inp.classList.contains(\"hidden\")) inp.focus();\n    });\n\n    function checkCustomAux() {\n      const val = selectedMethodValues(document.getElementById(\"select-aux-equip\"));\n      const inp = document.getElementById(\"input-custom-aux\");\n      if (val.includes(\"✏️ 직접 입력...\")) {\n        inp.classList.remove(\"hidden\");\n        inp.focus();\n      } else {\n        inp.classList.add(\"hidden\");\n      }\n    }\n\n    function enhanceMobileMultiSelect(select, title) {\n      if (!select || select._mobileMultiRefresh) return;\n      select.classList.add(\"mobile-multi-native\");\n      select.removeAttribute(\"size\");\n\n      const trigger = document.createElement(\"button\");\n      trigger.type = \"button\";\n      trigger.className = \"mobile-multi-trigger w-full flex items-center justify-between gap-2 rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs text-slate-800 shadow-sm\";\n      const summary = document.createElement(\"span\");\n      summary.className = \"min-w-0 truncate\";\n      const count = document.createElement(\"span\");\n      count.className = \"shrink-0 rounded-full bg-blue-100 px-2 py-0.5 text-[10px] font-bold text-blue-700\";\n      trigger.append(summary, count);\n      select.insertAdjacentElement(\"afterend\", trigger);\n\n      const refresh = () => {\n        const selected = Array.from(select.selectedOptions || []).filter(option => option.value);\n        const placeholder = Array.from(select.options || []).find(option => !option.value)?.text || `${title} 선택`;\n        summary.textContent = selected.length ? selected.map(option => option.text).join(\", \") : placeholder;\n        count.textContent = selected.length ? `${selected.length}개` : \"선택\";\n        count.classList.toggle(\"bg-blue-100\", selected.length > 0);\n        count.classList.toggle(\"text-blue-700\", selected.length > 0);\n        count.classList.toggle(\"bg-slate-200\", selected.length === 0);\n        count.classList.toggle(\"text-slate-600\", selected.length === 0);\n        trigger.title = summary.textContent;\n      };\n      select._mobileMultiRefresh = refresh;\n\n      const openPicker = () => {\n        const overlay = document.createElement(\"div\");\n        overlay.className = \"fixed inset-0 z-[80] flex items-end justify-center bg-slate-950/60 p-0 sm:items-center sm:p-4\";\n        const panel = document.createElement(\"div\");\n        panel.className = \"mobile-multi-dialog flex w-full max-w-lg flex-col overflow-hidden rounded-t-2xl bg-white shadow-2xl sm:rounded-2xl\";\n        const header = document.createElement(\"div\");\n        header.className = \"flex items-center justify-between border-b border-slate-200 px-4 py-3\";\n        const heading = document.createElement(\"strong\");\n        heading.className = \"text-sm text-slate-900\";\n        heading.textContent = `${title} 복수선택`;\n        const doneTop = document.createElement(\"button\");\n        doneTop.type = \"button\";\n        doneTop.className = \"rounded-lg bg-blue-700 px-3 py-1.5 text-xs font-bold text-white\";\n        doneTop.textContent = \"완료\";\n        header.append(heading, doneTop);\n        const search = document.createElement(\"input\");\n        search.type = \"search\";\n        search.placeholder = \"목록 검색\";\n        search.className = \"m-3 mb-2 rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm outline-none focus:border-blue-500\";\n        const list = document.createElement(\"div\");\n        list.className = \"min-h-0 flex-1 overflow-y-auto px-3 pb-3\";\n        const footer = document.createElement(\"div\");\n        footer.className = \"flex items-center justify-between border-t border-slate-200 px-4 py-3\";\n        const clear = document.createElement(\"button\");\n        clear.type = \"button\";\n        clear.className = \"text-xs font-semibold text-slate-500\";\n        clear.textContent = \"전체 해제\";\n        const selectedCount = document.createElement(\"span\");\n        selectedCount.className = \"text-xs font-bold text-blue-700\";\n        footer.append(clear, selectedCount);\n        panel.append(header, search, list, footer);\n        overlay.append(panel);\n        document.body.append(overlay);\n\n        const close = () => { refresh(); overlay.remove(); trigger.focus(); };\n        const updateCount = () => {\n          selectedCount.textContent = `${Array.from(select.selectedOptions || []).filter(option => option.value).length}개 선택`;\n        };\n        const render = () => {\n          const query = search.value.trim().toLowerCase();\n          list.replaceChildren();\n          Array.from(select.options || []).filter(option => option.value && (!query || option.text.toLowerCase().includes(query))).forEach(option => {\n            const row = document.createElement(\"label\");\n            row.className = \"flex cursor-pointer items-start gap-3 border-b border-slate-100 px-1 py-3 text-sm text-slate-800 last:border-0\";\n            const checkbox = document.createElement(\"input\");\n            checkbox.type = \"checkbox\";\n            checkbox.checked = option.selected;\n            checkbox.className = \"mt-0.5 h-5 w-5 shrink-0 accent-blue-700\";\n            const label = document.createElement(\"span\");\n            label.className = \"break-words leading-5\";\n            label.textContent = option.text;\n            checkbox.addEventListener(\"change\", () => {\n              option.selected = checkbox.checked;\n              select.dispatchEvent(new Event(\"change\", { bubbles: true }));\n              updateCount();\n            });\n            row.append(checkbox, label);\n            list.append(row);\n          });\n          if (!list.children.length) {\n            const empty = document.createElement(\"p\");\n            empty.className = \"py-8 text-center text-xs text-slate-400\";\n            empty.textContent = \"검색 결과가 없습니다.\";\n            list.append(empty);\n          }\n        };\n        search.addEventListener(\"input\", render);\n        clear.addEventListener(\"click\", () => {\n          Array.from(select.options || []).forEach(option => { option.selected = false; });\n          select.dispatchEvent(new Event(\"change\", { bubbles: true }));\n          render();\n          updateCount();\n        });\n        doneTop.addEventListener(\"click\", close);\n        overlay.addEventListener(\"click\", event => { if (event.target === overlay) close(); });\n        render();\n        updateCount();\n        setTimeout(() => search.focus(), 50);\n      };\n\n      trigger.addEventListener(\"click\", openPicker);\n      select.addEventListener(\"change\", refresh);\n      if (typeof MutationObserver !== \"undefined\") new MutationObserver(refresh).observe(select, { childList: true, subtree: true });\n      refresh();\n    }\n\n    [\n      [\"select-equip\", \"주 장비\"],\n      [\"select-aux-equip\", \"기타 보조장비\"],\n      [\"select-paut-scanner\", \"스캐너\"],\n      [\"select-paut-probe\", \"탐촉자\"],\n      [\"select-paut-wedge\", \"웻지\"]\n    ].forEach(([id, title]) => enhanceMobileMultiSelect(document.getElementById(id), title));\n\n    // Hot-tapping toggle\n    document.getElementById(\"select-loc-type\").addEventListener(\"change\", function () {\n      const isHotTap = this.value === \"핫태핑\";\n      const card = document.getElementById(\"hottap-card\");\n      if (isHotTap) {\n        card.classList.remove(\"hidden\");\n      } else {\n        card.classList.add(\"hidden\");\n      }\n    });\n\n    // Pipe calculator toggle\n    document.getElementById(\"btn-toggle-pipe-calc\").addEventListener(\"click\", () => {\n      isPipeCalcOpen = !isPipeCalcOpen;\n      applyPipeSectionState();\n    });\n\n    function applyPipeSectionState() {\n      const section = document.getElementById(\"pipe-calc-section\");\n      const btnText = document.getElementById(\"pipe-calc-btn-text\");\n      if (isPipeCalcOpen) {\n        section.classList.remove(\"hidden\");\n        btnText.textContent = \"배관 관경 계산기 접기\";\n      } else {\n        section.classList.add(\"hidden\");\n        btnText.textContent = \"배관 관경 계산기 펼치기\";\n      }\n    }\n\n    // Inspection item name change handler\n    document.getElementById(\"select-item-name\").addEventListener(\"change\", function () {\n      const item = this.value;\n      const banner = document.getElementById(\"non-pipe-banner\");\n      const isPipe = item === \"Piping\" || item === \"Pipe\";\n\n      if (isPipe) {\n        banner.classList.add(\"hidden\");\n        isPipeCalcOpen = true;\n        applyPipeSectionState();\n        isManualQty = false;\n        updatePipeCalc();\n      } else {\n        banner.classList.remove(\"hidden\");\n        isPipeCalcOpen = false;\n        applyPipeSectionState();\n        isManualQty = true;\n      }\n    });\n\n    function loadConfig() {\n      if (typeof google !== 'undefined' && google.script && google.script.run) {\n        google.script.run\n          .withSuccessHandler(res => {\n            if (res) initData(res, false);\n          })\n          .withFailureHandler(err => {\n            console.warn(\"설정 비동기 갱신 대기 (기본값 유지):\", err);\n          })\n          .getConfig();\n      } else {\n        fetch(\"/api/config\")\n          .then(r => r.json())\n          .then(res => initData(res, false))\n          .catch(err => console.warn(\"로컬 설정 로드 대기:\", err));\n      }\n    }\n\n    function initData(cfg, shouldLoadRecent = true) {\n      if (!cfg) return;\n      try {\n        const savedInput = window.workspaceCapture ? workspaceCapture() : null;\n        const raw = (typeof cfg === 'string') ? JSON.parse(cfg) : cfg;\n        appConfig = Object.assign({}, DEFAULT_CONFIG, raw);\n\n        // Pipe sizes\n        const pipeSelect = document.getElementById(\"select-pipe\");\n        if (pipeSelect && appConfig.pipe_sizes) {\n          pipeSelect.innerHTML = appConfig.pipe_sizes.map(p => `<option value=\"${p}\" ${p === '250A' ? 'selected' : ''}>${p}</option>`).join(\"\");\n        }\n\n        // Equipments & Vehicles\n        const equipSelect = document.getElementById(\"select-equip\");\n        if (equipSelect && appConfig.equipments) {\n          equipSelect.innerHTML = appConfig.equipments.map(e => `<option value=\"${e}\">${e}</option>`).join(\"\");\n        }\n        const auxSelect = document.getElementById(\"select-aux-equip\");\n        if (auxSelect && appConfig.aux_equipments) {\n          auxSelect.innerHTML = appConfig.aux_equipments.map(e => `<option value=\"${e}\">${e}</option>`).join(\"\") + '<option value=\"✏️ 직접 입력...\">✏️ 직접 입력...</option>';\n        }\n        const vehSelect = document.getElementById(\"select-vehicle\");\n        if (vehSelect && appConfig.vehicles) {\n          vehSelect.innerHTML = appConfig.vehicles.map(v => `<option value=\"${v}\">${v}</option>`).join(\"\");\n        }\n\n        // Companies\n        const compSelect = document.getElementById(\"select-company\");\n        if (compSelect && appConfig.companies) {\n          compSelect.innerHTML = appConfig.companies.map(c => `<option value=\"${c}\" ${c === '한국지역난방공사 중앙지사' ? 'selected' : ''}>${c}</option>`).join(\"\");\n        }\n\n        if (workerRows.length === 0) {\n          initDefaultWorkers();\n        }\n        switchMethod(selectedMethod || \"PAUT\");\n        if (savedInput && window.workspaceRestore) workspaceRestore(savedInput);\n        renderWorkers();\n        if (shouldLoadRecent) {\n          loadRecentRecords();\n        }\n      } catch (err) {\n        console.error(\"initData error:\", err);\n      }\n    }\n\n    function updateMaterialOptions(method) { refreshMethodChoices(method); }\n\n    function initDefaultWorkers() {\n      workerRows = [\n        { user: \"부장 주진철\", shift: \"주간\", time: \"09:00~18:00\", ot: \"0\" },\n        { user: \"부장 이병국\", shift: \"주간\", time: \"09:00~18:00\", ot: \"0\" }\n      ];\n      renderWorkers();\n    }\n\n    function renderWorkers() {\n      const container = document.getElementById(\"workers-container\");\n      container.innerHTML = \"\";\n\n      workerRows.forEach((w, idx) => {\n        const row = document.createElement(\"div\");\n        row.className = \"p-3 bg-slate-50 border border-slate-200/90 rounded-xl space-y-2 relative\";\n        row.innerHTML = `\n          <div class=\"flex items-center justify-between\">\n            <span class=\"text-xs font-bold text-slate-700\">참여자 ${idx + 1}</span>\n            ${idx > 0 ? `<button type=\"button\" onclick=\"removeWorker(${idx})\" class=\"text-slate-400 hover:text-rose-500 p-0.5\"><i data-lucide=\"trash-2\" class=\"w-3.5 h-3.5\"></i></button>` : ''}\n          </div>\n          <div class=\"grid grid-cols-2 gap-2\">\n            <div>\n              <label class=\"block text-[10px] text-slate-400 mb-0.5\">성명</label>\n              <select onchange=\"updateWorkerField(${idx}, 'user', this.value)\" class=\"w-full bg-white border border-slate-200 rounded-lg px-2 py-1.5 text-xs font-semibold text-slate-800\">\n                ${appConfig ? appConfig.users.map(u => `<option value=\"${u}\" ${u === w.user ? 'selected' : ''}>${u}</option>`).join(\"\") : `<option>${w.user}</option>`}\n              </select>\n            </div>\n            <div>\n              <label class=\"block text-[10px] text-slate-400 mb-0.5\">근무형태</label>\n              <select onchange=\"updateWorkerField(${idx}, 'shift', this.value)\" class=\"w-full bg-white border border-slate-200 rounded-lg px-2 py-1.5 text-xs font-semibold text-slate-800\">\n                <option value=\"주간\" ${w.shift === '주간' ? 'selected' : ''}>주간</option>\n                <option value=\"야간\" ${w.shift === '야간' ? 'selected' : ''}>야간</option>\n                <option value=\"휴일\" ${w.shift === '휴일' ? 'selected' : ''}>휴일</option>\n              </select>\n            </div>\n          </div>\n          <div class=\"grid grid-cols-2 gap-2\">\n            <div>\n              <label class=\"block text-[10px] text-slate-400 mb-0.5\">근무시간</label>\n              <select onchange=\"onWorkerTimeChange(${idx}, this.value)\" class=\"w-full bg-white border border-slate-200 rounded-lg px-2 py-1.5 text-xs text-slate-800\">\n                ${appConfig ? appConfig.worktimes.map(t => `<option value=\"${t}\" ${t === w.time ? 'selected' : ''}>${t}</option>`).join(\"\") : `<option>${w.time}</option>`}\n                ${appConfig && !appConfig.worktimes.includes(w.time) ? `<option value=\"${w.time}\" selected>${w.time}</option>` : ''}\n                <option value=\"__custom__\">✏️ 직접 입력...</option>\n              </select>\n            </div>\n            <div>\n              <label class=\"block text-[10px] text-slate-400 mb-0.5\">산출 수당 (원)</label>\n              <label class=\"block text-[10px] text-slate-400\">일비 (원)</label>\n              <input type=\"number\" min=\"0\" value=\"${Number(w.meal || 0)}\" onchange=\"updateWorkerField(${idx}, 'meal', this.value)\" class=\"w-full border rounded-lg p-1 text-xs\">\n              <input type=\"text\" value=\"${w.ot}\" readonly class=\"w-full bg-slate-100 border border-slate-200 rounded-lg px-2 py-1.5 text-xs font-black text-blue-800 text-right\">\n            </div>\n          </div>\n        `;\n        container.appendChild(row);\n      });\n      safeCreateIcons();\n    }\n\n    function updateWorkerField(idx, field, val) {\n      if (workerRows[idx]) workerRows[idx][field] = val;\n    }\n\n    function onWorkerTimeChange(idx, timeVal) {\n      if (timeVal === '__custom__') {\n        const custom = prompt('근무시간을 직접 입력하세요 (예: 09:00~익일05:00):');\n        if (custom && custom.trim()) {\n          timeVal = custom.trim();\n          if (appConfig && appConfig.worktimes && !appConfig.worktimes.includes(timeVal)) {\n            appConfig.worktimes.push(timeVal);\n          }\n        } else {\n          renderWorkers();\n          return;\n        }\n      }\n      updateWorkerField(idx, 'time', timeVal);\n      // Client-side quick calculation for OT\n      // Client-side accurate calculation for OT (supports overnight hours up to 익일09:00+)\n      let ot = 0;\n      if (timeVal.includes(\"20:00\")) ot = 15000;\n      else if (timeVal.includes(\"22:00\")) ot = 30000;\n      else if (timeVal.includes(\"24:00\")) ot = 50000;\n      else if (timeVal.includes(\"02:00\")) ot = 75000;\n      else if (timeVal.includes(\"03:00\")) ot = 90000;\n      const m = timeVal.match(/(\\d{1,2}):(\\d{2})\\s*[~−-]\\s*(?:익일\\s*)?(\\d{1,2}):(\\d{2})/);\n      if (m) {\n        let sh = parseInt(m[1], 10), sm = parseInt(m[2], 10);\n        let eh = parseInt(m[3], 10), em = parseInt(m[4], 10);\n        let start = sh + sm / 60;\n        let end = eh + em / 60;\n        if (end < start || (timeVal.includes('익일') && end <= start)) end += 24;\n\n        let dateInput = document.getElementById(\"input-date\");\n        let dateVal = dateInput ? dateInput.value : \"\";\n        let d = dateVal ? new Date(dateVal) : new Date();\n        let dayOfWeek = d.getDay(); // 0: Sun, 5: Fri, 6: Sat\n        let isHoliday = timeVal.includes('휴일') || (workerRows[idx] && workerRows[idx].shift === '휴일') || dayOfWeek === 0 || dayOfWeek === 6;\n\n        if (isHoliday) {\n          ot = Math.round((end - start) * 7500);\n        } else {\n          let dayH = Math.max(0, Math.min(end, 22) - Math.max(start, 18));\n          let nightH = Math.max(0, Math.min(end, 24) - Math.max(start, 22));\n          let dawnH = Math.max(0, end - Math.max(start, 24));\n          let dawnRate = (dayOfWeek === 5) ? 7500 : 5000;\n          ot = Math.round((dayH * 4000) + (nightH * 5000) + (dawnH * dawnRate));\n        }\n      } else {\n        if (timeVal.includes(\"20:00\")) ot = 15000;\n        else if (timeVal.includes(\"22:00\")) ot = 30000;\n        else if (timeVal.includes(\"24:00\")) ot = 50000;\n        else if (timeVal.includes(\"02:00\")) ot = 75000;\n        else if (timeVal.includes(\"03:00\")) ot = 90000;\n      }\n      workerRows[idx].ot = ot.toLocaleString();\n      renderWorkers();\n    }\n\n    function removeWorker(idx) {\n      workerRows.splice(idx, 1);\n      renderWorkers();\n    }\n\n    document.getElementById(\"btn-add-worker\").addEventListener(\"click\", () => {\n      const firstUser = appConfig ? appConfig.users[0] : \"부장 주진철\";\n      workerRows.push({ user: firstUser, shift: \"주간\", time: \"09:00~18:00\", ot: \"0\" });\n      renderWorkers();\n    });\n\n    document.getElementById(\"btn-batch-apply\").addEventListener(\"click\", () => {\n      if (workerRows.length > 0) {\n        const lead = workerRows[0];\n        for (let i = 1; i < workerRows.length; i++) {\n          workerRows[i].shift = lead.shift;\n          workerRows[i].time = lead.time;\n          workerRows[i].ot = lead.ot;\n        }\n        renderWorkers();\n        showToast(\"대표 참여자 설정이 일괄 적용되었습니다.\");\n      }\n    });\n\n    // Method Switching\n    function switchMethod(method) {\n      selectedMethod = method;\n\n      document.querySelectorAll(\".method-btn\").forEach(btn => {\n        if (btn.dataset.method === method) {\n          btn.className = \"method-btn py-2 text-xs font-bold rounded-lg bg-blue-600 text-white shadow-sm transition\";\n        } else {\n          btn.className = \"method-btn py-2 text-xs font-bold rounded-lg text-slate-600 hover:bg-white transition\";\n        }\n      });\n\n      const rtkCard = document.getElementById(\"rtk-card\");\n      const chemCard = document.getElementById(\"chemicals-card\");\n      const pautCard = document.getElementById(\"paut-guide-card\");\n      const rtJointsBox = document.getElementById(\"rt-joints-box\");\n      const nonRtJointsBox = document.getElementById(\"non-rt-joints-box\");\n      const unitSelect = document.getElementById(\"select-unit\");\n\n      updateMaterialOptions(method);\n\n      if (method === \"RT\") {\n        rtkCard.classList.remove(\"hidden\");\n        chemCard.classList.add(\"hidden\");\n        pautCard.classList.add(\"hidden\");\n        rtJointsBox.classList.remove(\"hidden\");\n        nonRtJointsBox.classList.add(\"hidden\");\n        unitSelect.value = \"매\";\n        document.getElementById(\"input-unit-price\").value = appConfig.base_prices.RT;\n      } else if (method === \"PAUT\") {\n        rtkCard.classList.add(\"hidden\");\n        chemCard.classList.add(\"hidden\");\n        pautCard.classList.remove(\"hidden\");\n        rtJointsBox.classList.add(\"hidden\");\n        nonRtJointsBox.classList.remove(\"hidden\");\n        unitSelect.value = \"M\";\n        document.getElementById(\"input-unit-price\").value = appConfig.base_prices.PAUT;\n      } else if (method === \"UT\") {\n        rtkCard.classList.add(\"hidden\"); chemCard.classList.add(\"hidden\");\n        pautCard.classList.remove(\"hidden\"); rtJointsBox.classList.add(\"hidden\");\n        nonRtJointsBox.classList.remove(\"hidden\"); unitSelect.value = \"M\";\n        document.getElementById(\"input-unit-price\").value = appConfig.base_prices.UT || 0;\n      } else {\n        rtkCard.classList.add(\"hidden\");\n        chemCard.classList.remove(\"hidden\");\n        pautCard.classList.add(\"hidden\");\n        rtJointsBox.classList.add(\"hidden\");\n        nonRtJointsBox.classList.remove(\"hidden\");\n        unitSelect.value = (method === \"MT\") ? \"P,M,I/D\" : \"M\";\n        document.getElementById(\"input-unit-price\").value = appConfig.base_prices[selectedMethod] || 0;\n      }\n\n      applyMethodDefaults(method);\n      if (!isManualQty) {\n        updatePipeCalc();\n      } else {\n        recalculateTotalFee();\n      }\n    }\n\n    document.querySelectorAll(\".method-btn\").forEach(btn => {\n      btn.addEventListener(\"click\", () => switchMethod(btn.dataset.method));\n    });\n\n    // Calculation logic\n    function updatePipeCalc() {\n      if (isManualQty) {\n        recalculateTotalFee();\n        return;\n      }\n\n      const pipe = document.getElementById(\"select-pipe\").value;\n      const baseLen = (appConfig && appConfig.size_lengths && appConfig.size_lengths[pipe]) ? appConfig.size_lengths[pipe] : 0.8401;\n\n      let qty = 0;\n      if (selectedMethod === \"RT\") {\n        const oriJoints = parseFloat(document.getElementById(\"input-ori-joints\").value) || 0;\n        qty = oriJoints * 3.0; // 3 films per joint\n      } else {\n        const joints = parseFloat(document.getElementById(\"input-joints\").value) || 0;\n        qty = parseFloat((baseLen * joints).toFixed(4));\n      }\n\n      document.getElementById(\"input-qty\").value = qty;\n      recalculateTotalFee();\n    }\n\n    document.getElementById(\"select-pipe\").addEventListener(\"change\", updatePipeCalc);\n    document.getElementById(\"input-joints\").addEventListener(\"input\", updatePipeCalc);\n    document.getElementById(\"input-ori-joints\").addEventListener(\"input\", updatePipeCalc);\n\n    document.getElementById(\"input-qty\").addEventListener(\"input\", () => {\n      isManualQty = true;\n      recalculateTotalFee();\n    });\n\n    document.getElementById(\"input-unit-price\").addEventListener(\"input\", recalculateTotalFee);\n    document.getElementById(\"input-travel-cost\").addEventListener(\"input\", recalculateTotalFee);\n\n    function recalculateTotalFee() {\n      const qty = parseFloat(document.getElementById(\"input-qty\").value) || 0;\n      const unitPrice = parseFloat(document.getElementById(\"input-unit-price\").value) || 0;\n      const travelCost = parseFloat(document.getElementById(\"input-travel-cost\").value) || 0;\n      const total = Math.trunc((qty * unitPrice) + travelCost);\n      document.getElementById(\"input-total-fee\").value = total;\n    }\n\n    // RTK Defect Calculations\n    document.querySelectorAll(\".rtk-inp\").forEach(inp => {\n      inp.addEventListener(\"input\", updateRtkTotal);\n    });\n\n    function updateRtkTotal() {\n      let sum = 0;\n      document.querySelectorAll(\".rtk-inp\").forEach(inp => {\n        sum += parseInt(inp.value) || 0;\n      });\n      document.getElementById(\"rtk-total\").value = sum;\n      document.getElementById(\"rtk-total-badge\").textContent = sum;\n    }\n\n    // Build payload\n    function getFormData() {\n      const isCustomItem = !document.getElementById(\"input-custom-item\").classList.contains(\"hidden\");\n      const itemName = isCustomItem ? document.getElementById(\"input-custom-item\").value.trim() : document.getElementById(\"select-item-name\").value;\n\n      const isCustomMat = !document.getElementById(\"input-custom-mat\").classList.contains(\"hidden\");\n      const material = isCustomMat ? document.getElementById(\"input-custom-mat\").value.trim() : document.getElementById(\"select-material\").value;\n\n      const aux = collectAuxEquipment();\n\n      return {\n        date: document.getElementById(\"input-date\").value,\n        company: document.getElementById(\"select-company\").value,\n        loc_type: document.getElementById(\"select-loc-type\").value,\n        hot_tap_stage: document.getElementById(\"hottap-stage\").value,\n        hot_tap_joints: document.getElementById(\"hottap-joints\").value,\n        hot_tap_pipe: document.getElementById(\"hottap-pipe\").value,\n        method: selectedMethod,\n        pipe: document.getElementById(\"select-pipe\").value,\n        item_name: itemName || \"Pipe\",\n        material: material,\n        applied_code: document.getElementById(\"select-applied-code\").value,\n        report_no: document.getElementById(\"input-report-no\").value.trim(),\n        joints: parseFloat(document.getElementById(\"input-joints\").value) || 0,\n        ori_joints: parseFloat(document.getElementById(\"input-ori-joints\").value) || 0,\n        rep_joints: parseFloat(document.getElementById(\"input-rep-joints\").value) || 0,\n        rej_qty: parseFloat(document.getElementById(\"input-rej-qty\").value) || 0,\n        qty: parseFloat(document.getElementById(\"input-qty\").value) || 0,\n        unit: document.getElementById(\"select-unit\").value,\n        unit_price: parseFloat(document.getElementById(\"input-unit-price\").value) || 0,\n        travel_cost: parseFloat(document.getElementById(\"input-travel-cost\").value) || 0,\n        lump_sum: document.getElementById(\"input-lump-sum\").value.trim(),\n        total_fee: parseFloat(document.getElementById(\"input-total-fee\").value) || 0,\n        equip_main: collectMainEquipment(),\n        equip_aux: aux,\n        vehicle_no: document.getElementById(\"select-vehicle\").value,\n        mileage: document.getElementById(\"input-mileage\").value.trim(),\n        vehicle_note: document.getElementById(\"input-vehicle-note\").value.trim(),\n        note: document.getElementById(\"input-note\").value.trim(),\n        workers: workerRows,\n        // RTK (8)\n        rtk_center_miss: parseInt(document.getElementById(\"rtk-center-miss\").value) || 0,\n        rtk_density: parseInt(document.getElementById(\"rtk-density\").value) || 0,\n        rtk_marking_miss: parseInt(document.getElementById(\"rtk-marking-miss\").value) || 0,\n        rtk_film_mark: parseInt(document.getElementById(\"rtk-film-mark\").value) || 0,\n        rtk_handling: parseInt(document.getElementById(\"rtk-handling\").value) || 0,\n        rtk_complaint: parseInt(document.getElementById(\"rtk-complaint\").value) || 0,\n        rtk_etc: parseInt(document.getElementById(\"rtk-etc\").value) || 0,\n        rtk_total: parseInt(document.getElementById(\"rtk-total\").value) || 0,\n        // Chemicals (7)\n        chem_fl_mag: parseFloat(document.getElementById(\"chem-fl-mag\").value) || 0,\n        chem_black_mag: parseFloat(document.getElementById(\"chem-black-mag\").value) || 0,\n        chem_white_paint: parseFloat(document.getElementById(\"chem-white-paint\").value) || 0,\n        chem_penetrant: parseFloat(document.getElementById(\"chem-penetrant\").value) || 0,\n        chem_cleaner: parseFloat(document.getElementById(\"chem-cleaner\").value) || 0,\n        chem_developer: parseFloat(document.getElementById(\"chem-developer\").value) || 0,\n        chem_fl_pen: parseFloat(document.getElementById(\"chem-fl-pen\").value) || 0\n      };\n    }\n\n    // Google Apps Script API Bridge & Local Fallback\n    function apiCall(action, payload) {\n      return new Promise((resolve, reject) => {\n        const handleGasResponse = (res) => {\n          if (typeof res === 'string') {\n            try {\n              resolve(JSON.parse(res));\n              return;\n            } catch (e) { }\n          }\n          resolve(res || {});\n        };\n\n        if (typeof google !== 'undefined' && google.script && google.script.run) {\n          if (action === 'getConfig') {\n            google.script.run.withSuccessHandler(handleGasResponse).withFailureHandler(reject).getConfig();\n          } else if (action === 'saveRecord') {\n            google.script.run.withSuccessHandler(handleGasResponse).withFailureHandler(reject).saveRecord(payload);\n          } else if (action === 'updateRecord' || action === 'update') {\n            google.script.run.withSuccessHandler(handleGasResponse).withFailureHandler(reject).updateRecord(payload);\n          } else if (action === 'deleteRecord' || action === 'delete') {\n            google.script.run.withSuccessHandler(handleGasResponse).withFailureHandler(reject).deleteRecord(payload);\n          } else if (action === 'getRecentRecords') {\n            google.script.run.withSuccessHandler(handleGasResponse).withFailureHandler(reject).getRecentRecords(payload);\n          } else {\n            reject(new Error(\"알 수 없는 API 액션: \" + action));\n          }\n        } else {\n          const endpointMap = {\n            'getConfig': '/api/config',\n            'getRecentRecords': `/api/recent_records?date=${encodeURIComponent(payload || '')}`,\n            'saveRecord': '/api/save_record',\n            'updateRecord': '/api/update_record',\n            'deleteRecord': '/api/delete_record',\n            'delete': '/api/delete_record',\n            'update': '/api/update_record'\n          };\n          const isPost = (action === 'saveRecord' || action === 'updateRecord' || action === 'deleteRecord' || action === 'delete' || action === 'update');\n          const targetUrl = endpointMap[action] || `?api=${action}`;\n          fetch(targetUrl, {\n            method: isPost ? 'POST' : 'GET',\n            headers: { 'Content-Type': 'application/json' },\n            body: isPost ? JSON.stringify(payload) : undefined\n          })\n            .then(res => res.json())\n            .then(resolve)\n            .catch(reject);\n        }\n      });\n    }\n\n    let currentEditingRecord = null;\n    window.recentRecordsList = [];\n\n    // Submit handler\n    document.getElementById(\"btn-submit\").addEventListener(\"click\", async () => {\n      if (!currentEditingRecord) { workspaceQueueCurrent(); return; }\n      const payload = getFormData();\n      const btn = document.getElementById(\"btn-submit\");\n      btn.disabled = true;\n      btn.classList.add(\"opacity-60\");\n\n      const isEditing = Boolean(currentEditingRecord);\n      const actionName = isEditing ? 'updateRecord' : 'saveRecord';\n      if (isEditing) {\n        payload.id = currentEditingRecord.id;\n        payload.client_request_id = currentEditingRecord.client_request_id;\n        try {\n          payload.material_id = materialConnectionForSave(payload.material);\n        } catch (connectionError) {\n          showToast(connectionError.message, true);\n          btn.disabled = false;\n          btn.classList.remove(\"opacity-60\");\n          return;\n        }\n        payload.entry_time = currentEditingRecord.entry_time;\n        payload.is_update = true;\n      }\n\n      try {\n        const rawRes = await apiCall(actionName, payload);\n        const res = (typeof rawRes === 'string') ? JSON.parse(rawRes) : (rawRes || {});\n        if (res && res.status === 'success') {\n          showToast(isEditing ? \"작업일보가 성공적으로 수정되었습니다!\" : \"중앙지사 구글 클라우드에 성공적으로 저장되었습니다!\");\n          if (isEditing) cancelEditMode();\n          loadRecentRecords();\n        } else {\n          showToast((res && (res.message || res.detail)) || (isEditing ? \"수정 실패\" : \"저장 실패\"), true);\n        }\n      } catch (err) {\n        showToast(\"오류 발생: \" + err.message, true);\n      } finally {\n        btn.disabled = false;\n        btn.classList.remove(\"opacity-60\");\n      }\n    });\n\n    // Start edit mode with full record population\n    window.startEditRecord = function (r) {\n      if (!r) return;\n      try {\n        currentEditingRecord = r;\n        window.scrollTo({ top: 0, behavior: 'smooth' });\n\n        const banner = document.getElementById(\"edit-banner\");\n        const bannerDesc = document.getElementById(\"edit-banner-desc\");\n        if (banner) banner.classList.remove(\"hidden\");\n        if (bannerDesc) bannerDesc.textContent = `${r.date} [${r.company}] ${r.method} · ${r.item_name || 'Pipe'} (${r.qty} ${r.unit})`;\n\n        if (r.date) document.getElementById(\"input-date\").value = r.date;\n        if (r.company) workspaceSelectValue(document.getElementById(\"select-company\"), r.company);\n        if (r.loc_type) {\n          const locSel = document.getElementById(\"select-loc-type\");\n          locSel.value = r.loc_type;\n          locSel.dispatchEvent(new Event('change'));\n        }\n\n        // Hot tapping\n        if (r.hot_tap_stage) document.getElementById(\"hottap-stage\").value = r.hot_tap_stage;\n        if (r.hot_tap_joints) document.getElementById(\"hottap-joints\").value = r.hot_tap_joints;\n        if (r.hot_tap_pipe) document.getElementById(\"hottap-pipe\").value = r.hot_tap_pipe;\n\n        if (r.method) switchMethod(r.method);\n\n        // Item Name\n        const itemSelect = document.getElementById(\"select-item-name\");\n        const customItem = document.getElementById(\"input-custom-item\");\n        if (r.item_name && itemSelect) {\n          let foundItem = false;\n          for (let opt of itemSelect.options) {\n            if (opt.value === r.item_name) { foundItem = true; break; }\n          }\n          if (foundItem) {\n            itemSelect.value = r.item_name;\n            if (customItem) { customItem.value = \"\"; customItem.classList.add(\"hidden\"); }\n          } else {\n            if (customItem) { customItem.value = r.item_name; customItem.classList.remove(\"hidden\"); }\n          }\n        }\n\n        // Material\n        const matSelect = document.getElementById(\"select-material\");\n        const customMat = document.getElementById(\"input-custom-mat\");\n        if (r.material && matSelect) {\n          let foundMat = false;\n          for (let opt of matSelect.options) {\n            if (opt.value === r.material) { foundMat = true; break; }\n          }\n          if (foundMat) {\n            matSelect.value = r.material;\n            if (customMat) { customMat.value = \"\"; customMat.classList.add(\"hidden\"); }\n          } else {\n            if (customMat) { customMat.value = r.material; customMat.classList.remove(\"hidden\"); }\n          }\n        }\n\n        if (r.applied_code) document.getElementById(\"select-applied-code\").value = r.applied_code;\n        if (r.report_no) document.getElementById(\"input-report-no\").value = r.report_no;\n\n        if (r.pipe) document.getElementById(\"select-pipe\").value = r.pipe;\n        if (r.joints !== undefined) document.getElementById(\"input-joints\").value = r.joints;\n        if (r.ori_joints !== undefined) document.getElementById(\"input-ori-joints\").value = r.ori_joints;\n        if (r.rep_joints !== undefined) document.getElementById(\"input-rep-joints\").value = r.rep_joints;\n        if (r.rej_qty !== undefined) document.getElementById(\"input-rej-qty\").value = r.rej_qty;\n\n        if (r.qty !== undefined) {\n          isManualQty = true;\n          document.getElementById(\"input-qty\").value = r.qty;\n        }\n        if (r.unit) document.getElementById(\"select-unit\").value = r.unit;\n        if (r.unit_price !== undefined) document.getElementById(\"input-unit-price\").value = r.unit_price;\n        if (r.travel_cost !== undefined) document.getElementById(\"input-travel-cost\").value = r.travel_cost;\n        if (r.lump_sum !== undefined) document.getElementById(\"input-lump-sum\").value = r.lump_sum || '';\n        if (r.total_fee !== undefined) document.getElementById(\"input-total-fee\").value = r.total_fee;\n\n        setMethodValues(document.getElementById(\"select-equip\"), String(r.equip_main || \"\").split(';'));\n        restoreAuxEquipment(r.equip_aux || '');\n\n        if (r.vehicle_no) document.getElementById(\"select-vehicle\").value = r.vehicle_no;\n        if (r.mileage) document.getElementById(\"input-mileage\").value = r.mileage;\n        if (r.vehicle_note) document.getElementById(\"input-vehicle-note\").value = r.vehicle_note;\n        if (r.note) document.getElementById(\"input-note\").value = r.note;\n\n        restoreMaterialConnection(r.material_id || '');\n\n        // RTK\n        const rtkFields = ['rtk-center-miss', 'rtk-density', 'rtk-marking-miss', 'rtk-film-mark', 'rtk-handling', 'rtk-complaint', 'rtk-etc', 'rtk-total'];\n        const rtkKeys = ['rtk_center_miss', 'rtk_density', 'rtk_marking_miss', 'rtk_film_mark', 'rtk_handling', 'rtk_complaint', 'rtk_etc', 'rtk_total'];\n        for (let i = 0; i < rtkFields.length; i++) {\n          const el = document.getElementById(rtkFields[i]);\n          if (el) el.value = r[rtkKeys[i]] || 0;\n        }\n        updateRtkTotal();\n\n        // Chemicals\n        const chemFields = ['chem-fl-mag', 'chem-black-mag', 'chem-white-paint', 'chem-penetrant', 'chem-cleaner', 'chem-developer', 'chem-fl-pen'];\n        const chemKeys = ['chem_fl_mag', 'chem_black_mag', 'chem_white_paint', 'chem_penetrant', 'chem_cleaner', 'chem_developer', 'chem_fl_pen'];\n        for (let i = 0; i < chemFields.length; i++) {\n          const el = document.getElementById(chemFields[i]);\n          if (el) el.value = r[chemKeys[i]] || 0;\n        }\n\n        // Workers\n        if (r.worker_list && Array.isArray(r.worker_list) && r.worker_list.length > 0) {\n          workerRows = JSON.parse(JSON.stringify(r.worker_list));\n        } else if (!Array.isArray(workerRows) || workerRows.length === 0) {\n          initDefaultWorkers();\n        }\n        renderWorkers();\n\n        // Update Submit Button Appearance for Edit Mode\n        const submitBtn = document.getElementById(\"btn-submit\");\n        if (submitBtn) {\n          submitBtn.className = \"w-full py-4 bg-gradient-to-r from-amber-600 to-orange-600 text-white font-extrabold text-base rounded-2xl shadow-lg shadow-amber-500/30 hover:brightness-110 active:scale-95 transition flex items-center justify-center gap-2\";\n          submitBtn.innerHTML = '<i data-lucide=\"check\" class=\"w-5 h-5\"></i><span>작업일보 수정 완료 (클라우드 저장)</span>';\n          safeCreateIcons();\n        }\n\n        showToast(\"일보 수정 모드로 전환되었습니다.\");\n      } catch (err) {\n        console.error(\"startEditRecord error:\", err);\n        showToast(\"수정 모드 전환 오류: \" + err.message, true);\n      }\n    };\n\n    window.startEditRecordByIndex = function (idx) {\n      if (!window.recentRecordsList || !window.recentRecordsList[idx]) return;\n      window.startEditRecord(window.recentRecordsList[idx]);\n    };\n\n    window.copyRecordByIndex = function (idx) {\n      if (!window.recentRecordsList || !window.recentRecordsList[idx]) return;\n      window.copyRecordToForm(window.recentRecordsList[idx]);\n    };\n\n    window.deleteRecordByIndex = function (idx) {\n      if (!window.recentRecordsList || !window.recentRecordsList[idx]) return;\n      window.deleteRecord(window.recentRecordsList[idx]);\n    };\n\n    function cancelEditMode() {\n      currentEditingRecord = null;\n      const banner = document.getElementById(\"edit-banner\");\n      if (banner) banner.classList.add(\"hidden\");\n\n      const submitBtn = document.getElementById(\"btn-submit\");\n      if (submitBtn) {\n        submitBtn.className = \"w-full py-4 bg-gradient-to-r from-blue-600 to-indigo-700 text-white font-extrabold text-base rounded-2xl shadow-lg shadow-blue-500/30 hover:brightness-110 active:scale-95 transition flex items-center justify-center gap-2\";\n        submitBtn.innerHTML = '<i data-lucide=\"send\" class=\"w-5 h-5\"></i><span>＋ 작업 목록에 추가</span>';\n        safeCreateIcons();\n      }\n    }\n\n    document.getElementById(\"btn-cancel-edit\").addEventListener(\"click\", () => {\n      cancelEditMode();\n      showToast(\"수정이 취소되었습니다.\");\n    });\n\n    window.deleteRecord = async function (r) {\n      if (!r) return;\n      const desc = `[${r.date} ${r.company} ${r.method} · ${r.item_name || 'Pipe'}]`;\n      if (!confirm(`${desc}\\n해당 작업일보 내역을 정말 삭제하시겠습니까?\\n\\n※ 삭제된 내역은 스프레드시트에서 즉시 제거됩니다.`)) {\n        return;\n      }\n\n      try {\n        const res = await apiCall('deleteRecord', { id: r.id, entry_time: r.entry_time });\n        if (res && res.status === 'success') {\n          showToast(`${desc} 내역이 삭제되었습니다.`);\n          if (currentEditingRecord && currentEditingRecord.entry_time === r.entry_time) {\n            cancelEditMode();\n          }\n          loadRecentRecords();\n        } else {\n          showToast((res && (res.message || res.detail)) || \"삭제 실패\", true);\n        }\n      } catch (e) {\n        showToast(\"삭제 오류: \" + e.message, true);\n      }\n    };\n\n    // Recent records\n    async function loadRecentRecords() {\n      const container = document.getElementById(\"recent-list\");\n      const date = document.getElementById(\"input-date\").value;\n\n      try {\n        const rawRes = await apiCall('getRecentRecords', date);\n        const res = (typeof rawRes === 'string') ? JSON.parse(rawRes) : (rawRes || {});\n        const list = res.records || [];\n        if (list.length === 0) {\n          container.innerHTML = `<div class=\"text-center py-4 text-xs text-slate-400\">당일(${date}) 저장된 내역이 없습니다. (새 작업을 저장하거나 날짜를 변경해 보세요)</div>`;\n          window.recentRecordsList = [];\n          return;\n        }\n\n        window.recentRecordsList = list;\n        let headerHtml = '';\n        if (res.is_fallback) {\n          headerHtml = `<div class=\"p-2.5 mb-2.5 bg-blue-50 border border-blue-200 rounded-xl text-xs text-blue-900 font-bold flex items-center justify-between\">\n            <span>ℹ️ 선택일(${date}) 내역이 없어 <strong>[최근 등록 내역]</strong>을 표시합니다.</span>\n            <span class=\"text-[10px] text-blue-700 bg-blue-100 px-2 py-0.5 rounded-full font-extrabold\">${list.length}건</span>\n          </div>`;\n        }\n\n        container.innerHTML = headerHtml + list.map((item, idx) => `\n          <div class=\"p-3.5 bg-slate-900 text-slate-100 rounded-2xl mb-3 shadow-md border border-slate-700/80\">\n            <div class=\"flex items-start justify-between gap-2\">\n              <div>\n                <span class=\"inline-block px-2 py-0.5 rounded-md ${item.method === 'PAUT' ? 'bg-blue-500/20 text-blue-400' : (item.method === 'RT' ? 'bg-purple-500/20 text-purple-400' : 'bg-amber-500/20 text-amber-400')} font-extrabold text-[11px] mb-1\">[${item.company}] ${item.method} · ${item.item_name || 'Pipe'}${item.pipe ? ` (${item.pipe})` : ''}</span>\n                <div class=\"text-[11px] text-slate-400 font-medium\">\n                  📅 ${item.date} · 🏢 ${item.loc_type || item.site}${item.applied_code ? ` · ${item.applied_code}` : ''}\n                </div>\n              </div>\n              <div class=\"text-right\">\n                <span class=\"block font-black text-white text-sm\">${item.qty} ${item.unit}</span>\n                <span class=\"text-[11px] text-blue-400 font-bold\">${Number(item.total_fee || 0).toLocaleString()}원</span>\n              </div>\n            </div>\n\n            ${item.report_no ? `<div class=\"text-[10px] text-slate-400 mt-1\">📄 성적서: ${item.report_no}</div>` : ''}\n            ${item.workers ? `<div class=\"text-[10px] text-slate-300 bg-slate-800/90 p-1.5 rounded-lg border border-slate-700/60 mt-1.5\">👷 참여: ${item.workers}</div>` : ''}\n            ${item.extra ? `<div class=\"text-[10px] text-amber-400 font-bold mt-1\">🧪 ${item.extra}</div>` : ''}\n\n            <!-- 3 Action Buttons (Copy, Edit, Delete) -->\n            <div class=\"pt-2.5 mt-2.5 border-t border-slate-800 flex items-center justify-between gap-2 text-xs\">\n              <button type=\"button\" class=\"flex-1 py-1.5 px-2 bg-slate-800 hover:bg-slate-700 active:scale-95 text-slate-200 font-bold rounded-xl border border-slate-700 flex items-center justify-center gap-1 transition\" onclick=\"copyRecordByIndex(${idx})\">\n                <span>📋</span> <span>복사</span>\n              </button>\n              <button type=\"button\" class=\"flex-1 py-1.5 px-2 bg-amber-500/20 hover:bg-amber-500/30 active:scale-95 text-amber-300 font-bold rounded-xl border border-amber-500/40 flex items-center justify-center gap-1 transition\" onclick=\"startEditRecordByIndex(${idx})\">\n                <span>✏️</span> <span>수정</span>\n              </button>\n              <button type=\"button\" class=\"flex-1 py-1.5 px-2 bg-rose-500/20 hover:bg-rose-500/30 active:scale-95 text-rose-300 font-bold rounded-xl border border-rose-500/40 flex items-center justify-center gap-1 transition\" onclick=\"deleteRecordByIndex(${idx})\">\n                <span>🗑️</span> <span>삭제</span>\n              </button>\n            </div>\n          </div>\n        `).join(\"\");\n        safeCreateIcons();\n      } catch (err) {\n        container.innerHTML = `<div class=\"text-xs text-rose-500 py-2 text-center\">조회 실패: ${err.message}</div>`;\n      }\n    }\n\n    document.getElementById(\"btn-refresh-history\").addEventListener(\"click\", loadRecentRecords);\n    document.getElementById(\"input-date\").addEventListener(\"change\", loadRecentRecords);\n\n    function copyRecordToForm(item) {\n      if (!item) return;\n      if (item.method) switchMethod(item.method);\n      if (item.loc_type) {\n        document.getElementById(\"select-loc-type\").value = item.loc_type;\n        document.getElementById(\"select-loc-type\").dispatchEvent(new Event('change'));\n      }\n      if (item.pipe) document.getElementById(\"select-pipe\").value = item.pipe;\n      if (item.qty) {\n        document.getElementById(\"input-qty\").value = item.qty;\n        isManualQty = true;\n      }\n      if (item.unit) document.getElementById(\"select-unit\").value = item.unit;\n      if (item.unit_price) document.getElementById(\"input-unit-price\").value = item.unit_price;\n      if (item.travel_cost) document.getElementById(\"input-travel-cost\").value = item.travel_cost;\n      if (item.total_fee) document.getElementById(\"input-total-fee\").value = item.total_fee;\n      if (item.applied_code) document.getElementById(\"select-applied-code\").value = item.applied_code;\n      if (item.report_no) document.getElementById(\"input-report-no\").value = item.report_no;\n      showToast(\"선택한 내역이 입력 폼에 복사되었습니다.\");\n      window.scrollTo({ top: 0, behavior: 'smooth' });\n    }\n\n    // Initialize immediately with default central config (0ms instant render)\n    initData(<?!= JSON.stringify(getConfig()).replace(/</g, '\\\\u003c'); ?>, true);\n    loadConfig();\n    safeCreateIcons();\n  </script>\n  <style>\n  :root { --central-blue:#174a8b; }\n  body {background:#eef3f8;padding-bottom:90px!important;}\n  main {max-width:1000px!important;}\n  .workspace-panel {display:none;gap:16px;}\n  .workspace-panel.active {display:grid;}\n  #workspace-local-status {grid-column:1/-1;}\n  .workspace-nav {position:fixed;bottom:0;left:0;right:0;z-index:40;background:#fff;border-top:1px solid #cbd5e1;display:flex;padding:10px 8px max(10px,env(safe-area-inset-bottom));justify-content:center;gap:6px;}\n  .workspace-nav button {flex:1;max-width:180px;min-height:44px;border-radius:12px;font-size:13px;font-weight:700;color:#475569;}\n  .workspace-nav button[aria-selected=true] {background:var(--central-blue);color:white;}\n  .workspace-card {background:white;border:1px solid #dbe3ee;padding:18px;border-radius:16px;box-shadow:0 2px 8px #122d4b08;}\n  .workspace-card h2 {font-size:18px;font-weight:800;color:#17375b;margin-bottom:12px;}\n  .workspace-card>summary {cursor:pointer;font-size:14px;font-weight:800;color:#17375b;}\n  .workspace-check {display:flex!important;grid-template-columns:auto 1fr!important;align-items:center;gap:8px;margin:12px 0;font-size:13px!important;}\n  .workspace-check input {min-height:auto!important;width:18px;height:18px;}\n  .workspace-card p {font-size:13px;color:#475569;white-space:pre-wrap;overflow-wrap:anywhere;}\n  .workspace-card button {min-height:44px;padding:8px 14px;background:#eaf0f9;color:#174a8b;border-radius:10px;font-weight:700;font-size:13px;margin:6px 6px 0 0;}\n  .workspace-card button.primary {background:#174a8b;color:white;}\n  .workspace-card button:disabled {opacity:.5;}\n  .workspace-filters {display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;}\n  .workspace-filters label {display:grid;gap:5px;font-size:12px;color:#475569;}\n  .workspace-filters input,.workspace-filters select {min-width:0;min-height:44px;border:1px solid #cbd5e1;border-radius:9px;padding:8px;background:#f8fafc;}\n  .workspace-status {font-size:12px;background:#e8f0fa;color:#174a8b;border-radius:10px;padding:10px;margin-bottom:12px;}\n  .workspace-empty {padding:25px;text-align:center;color:#64748b;font-size:14px;}\n  .progress-kpi-grid {display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-bottom:14px;}\n  .progress-kpi-card {background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;padding:12px;}\n  .progress-kpi-card h3 {font-size:12px;font-weight:800;color:#475569;margin-bottom:4px;}\n  .progress-kpi-card .kpi-num {font-size:20px;font-weight:900;line-height:1.2;}\n  .progress-kpi-card .kpi-sub {font-size:11px;color:#64748b;margin-top:2px;}\n  .progress-bar-bg {width:100%;height:6px;background:#e2e8f0;border-radius:3px;margin-top:6px;overflow:hidden;}\n  .progress-bar-fill {height:100%;border-radius:3px;}\n  .progress-table-wrap {overflow-x:auto;-webkit-overflow-scrolling:touch;margin-top:12px;border-radius:12px;border:1px solid #cbd5e1;background:#fff;}\n  .progress-table {width:100%;border-collapse:collapse;font-size:12px;text-align:right;white-space:nowrap;}\n  .progress-table th,.progress-table td {padding:8px 6px;border-bottom:1px solid #e2e8f0;border-right:1px solid #f1f5f9;}\n  .progress-table th {background:#f1f5f9;color:#334155;font-weight:800;text-align:center;position:sticky;top:0;}\n  .progress-table td:nth-child(1),.progress-table td:nth-child(2) {text-align:left;font-weight:700;}\n  .progress-table tr.subtotal {background:#e8f0fe;font-weight:800;}\n  .progress-billing-card {background:#f8fafc;border:1px solid #cbd5e1;border-radius:14px;padding:14px;margin:14px 0;}\n  .progress-billing-total {font-size:22px;font-weight:900;color:#1e40af;line-height:1.2;}\n  .billing-sub-grid {display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin:10px 0;}\n  .billing-sub-item {background:#fff;border:1px solid #e2e8f0;border-radius:10px;padding:8px 10px;}\n  .billing-sub-item .title {font-size:11px;font-weight:700;color:#64748b;}\n  .billing-sub-item .amount {font-size:13px;font-weight:900;color:#1e293b;margin-top:2px;}\n  .billing-toggle-btn {width:100%;padding:10px 12px;background:#e2e8f0;color:#1e293b;border-radius:10px;font-weight:800;font-size:12px;text-align:center;cursor:pointer;border:none;margin-top:8px;}\n  .billing-toggle-btn:active {background:#cbd5e1;}\n  @media(min-width:760px){#workspace-input{grid-template-columns:1fr 1fr;align-items:start;}#workspace-input>#edit-banner,#workspace-input>div:last-child{grid-column:1/-1;}.workspace-filters{grid-template-columns:repeat(4,minmax(0,1fr));}.progress-kpi-grid{grid-template-columns:repeat(4,minmax(0,1fr));}.billing-sub-grid{grid-template-columns:repeat(4,minmax(0,1fr));}}\n</style>\n<script>\nconst WORKSPACE_STORAGE_KEY='central-mobile-workspace-v1';\nlet workspacePending=[], workspaceEditingId=null, workspaceSaving=false, workspacePage='input';\nlet workspaceStorageOK=true, workspaceDraft=null, workspaceTimer=null, workspaceSkipDraftCapture=false;\nfunction workspaceId(){return window.crypto && crypto.randomUUID ? crypto.randomUUID() : Date.now()+'-'+Math.random().toString(36).slice(2);}\nfunction workspaceNode(tag,text,cls){const e=document.createElement(tag);if(text!==undefined)e.textContent=text;if(cls)e.className=cls;return e;}\nfunction workspaceButton(text,fn,primary=false){const b=workspaceNode('button',text,primary?'primary':'');b.type='button';b.addEventListener('click',fn);return b;}\nfunction workspaceSelectValue(select,value){if(!select)return;if(!Array.from(select.options).some(o=>o.value===String(value)))select.add(new Option('(기존 저장값) '+value,value));select.value=value;}\nfunction workspaceCapture(){\n  const fields={};document.querySelectorAll('#workspace-input input[id],#workspace-input select[id],#workspace-input textarea[id]').forEach(e=>{fields[e.id]=e.type==='checkbox'?e.checked:(e.multiple?Array.from(e.selectedOptions).map(o=>o.value):e.value);});\n  return {fields,method:selectedMethod,workers:JSON.parse(JSON.stringify(workerRows)),editing:currentEditingRecord,editingQueue:workspaceEditingId};\n}\nfunction workspaceRestore(draft){\n  if(!draft)return;\n  if(draft.method)switchMethod(draft.method);\n  Object.entries(draft.fields||{}).forEach(([id,value])=>{const e=document.getElementById(id);if(!e)return;if(e.type==='checkbox')e.checked=Boolean(value);else if(e.tagName==='SELECT'&&e.multiple)setMethodValues(e,Array.isArray(value)?value:[value]);else if(e.tagName==='SELECT')workspaceSelectValue(e,value);else e.value=value;});\n  if(draft.workers){workerRows=JSON.parse(JSON.stringify(draft.workers));renderWorkers();}\n  workspaceEditingId=draft.editingQueue||null;\n  if(draft.editing){currentEditingRecord=draft.editing;document.getElementById('edit-banner').classList.remove('hidden');}\n  isManualQty=true;\n  restoreMaterialConnection(draft.fields?.['workspace-material-id']||'',Boolean(draft.fields?.['workspace-manual-link']));\n}\nfunction workspacePersist(){\n  workspaceDraft=workspaceSkipDraftCapture?null:workspaceCapture();\n  try{localStorage.setItem(WORKSPACE_STORAGE_KEY,JSON.stringify({pending:workspacePending,draft:workspaceDraft}));workspaceStorageOK=true;}\n  catch(error){workspaceStorageOK=false;}\n  const status=document.getElementById('workspace-local-status');\n  if(status)status.textContent=workspaceStorageOK?'이 기기에 임시저장됩니다. 클라우드 저장은 작업 목록에서 완료하세요.':'기기 임시저장을 사용할 수 없습니다. 화면을 닫기 전에 클라우드에 저장하세요.';\n}\nfunction workspaceSwitch(page){\n  workspacePage=page;document.querySelectorAll('.workspace-panel').forEach(p=>p.classList.toggle('active',p.id==='workspace-'+page));\n  document.querySelectorAll('.workspace-nav button').forEach(b=>b.setAttribute('aria-selected',String(b.dataset.page===page)));\n  if(page==='pending')workspaceRenderPending();\n  if(page==='progress')workspaceLoadProgress();\n  window.scrollTo({top:0,behavior:'smooth'});\n}\nasync function workspaceCall(name,payload){\n  if(typeof google==='undefined'||!google.script||!google.script.run)throw new Error('24시간 웹앱 주소에서 접속하세요.');\n  const result=await new Promise((resolve,reject)=>google.script.run.withSuccessHandler(resolve).withFailureHandler(reject)[name](payload));\n  return typeof result==='string'?JSON.parse(result):result;\n}\nfunction workspaceValidate(payload){\n  if(!payload.date||!payload.method)throw new Error('날짜와 검사방법을 확인하세요.');\n  for(const key of ['qty','unit_price','travel_cost','total_fee'])if(!Number.isFinite(Number(payload[key]))||Number(payload[key])<0)throw new Error('수량·금액을 확인하세요.');\n  if(payload.method==='RT'&&!Number.isInteger(Number(payload.qty)))throw new Error('RT 매수는 정수로 입력하세요.');\n  if(workspacePending.length>=30&&!workspaceEditingId)throw new Error('작업 목록은 최대 30건입니다. 먼저 저장하세요.');\n}\nfunction workspaceQueueCurrent(){\n  if(workspaceSaving)return;\n  try{\n    workspaceSkipDraftCapture=false;\n    const p=JSON.parse(JSON.stringify(getFormData()));workspaceValidate(p);\n    p.material_id=materialConnectionForSave(p.material);\n    p.client_request_id=workspaceEditingId||workspaceId();\n    const index=workspacePending.findIndex(r=>r.client_request_id===p.client_request_id);\n    if(index>=0)workspacePending[index]=p;else workspacePending.push(p);\n    workspaceEditingId=null;workspacePersist();workspaceRenderPending();workspaceSwitch('pending');showToast('작업 목록에 추가했습니다. 클라우드 저장을 눌러 완료하세요.');\n  }catch(error){showToast(error.message,true);}\n}\nfunction workspaceRenderPending(){\n  const list=document.getElementById('workspace-pending-list');if(!list)return;list.replaceChildren();\n  const total=workspacePending.reduce((sum,r)=>sum+Number(r.total_fee||0),0);\n  document.getElementById('workspace-pending-summary').textContent=workspacePending.length+'건 · 검사금액 '+total.toLocaleString()+'원';\n  if(!workspacePending.length)list.append(workspaceNode('p','등록할 작업 목록이 비어 있습니다.','workspace-empty'));\n  workspacePending.forEach((r,index)=>{\n    const card=workspaceNode('article',undefined,'workspace-card');card.append(workspaceNode('h2',(index+1)+'. '+r.date+' · '+r.method));\n    card.append(workspaceNode('p',r.company+' · '+r.loc_type+'\\n'+r.qty+' '+r.unit+' · '+Number(r.total_fee||0).toLocaleString()+'원\\n작업자: '+r.workers.map(w=>w.user).join(', ')));\n    const edit=workspaceButton('수정',()=>{startEditRecord({...r,worker_list:r.workers});cancelEditMode();workspaceEditingId=r.client_request_id;workspaceSkipDraftCapture=false;workspaceSwitch('input');workspacePersist();});\n    const remove=workspaceButton('목록에서 제외',()=>{if(!confirm('이 작업을 대기 목록에서 제외할까요?'))return;workspacePending=workspacePending.filter(x=>x.client_request_id!==r.client_request_id);workspacePersist();workspaceRenderPending();});\n    edit.disabled=remove.disabled=workspaceSaving;card.append(edit,remove);list.append(card);\n  });\n  const save=document.getElementById('workspace-save-batch');save.disabled=workspaceSaving||!workspacePending.length;\n  save.textContent=workspaceSaving?'클라우드 저장 중…':'목록 '+workspacePending.length+'건 클라우드 저장';\n}\nasync function workspaceSavePending(){\n  if(workspaceSaving||!workspacePending.length)return;\n  workspaceSaving=true;workspacePersist();workspaceRenderPending();\n  try{\n    const response=await workspaceCall('saveRecordsBatch',{records:workspacePending});\n    const saved=new Set((response.results||[]).filter(r=>r.status==='success').map(r=>r.request_id));\n    workspacePending=workspacePending.filter(r=>!saved.has(r.client_request_id));\n    workspacePersist();\n    if(workspacePending.length)throw new Error(saved.size+'건 저장, '+workspacePending.length+'건 대기. '+((response.results||[]).find(r=>r.status!=='success')||{}).detail);\n    showToast(saved.size+'건을 클라우드에 저장했습니다.');loadRecentRecords();\n  }catch(error){showToast('목록을 보존했습니다. '+error.message,true);}\n  finally{workspaceSaving=false;workspaceRenderPending();}\n}\nfunction workspaceFilter(parent,id,label,type='text',choices){\n  const wrapper=workspaceNode('label',label);const e=document.createElement(choices?'select':'input');e.id=id;\n  if(choices)choices.forEach(([value,text])=>e.add(new Option(text,value)));else e.type=type;\n  wrapper.append(e);parent.append(wrapper);return e;\n}\nasync function workspaceQuery(append=false){\n  const area=document.getElementById('workspace-query-list'),status=document.getElementById('workspace-query-status');\n  const offset=append?Number(area.dataset.offset||0):0;status.textContent='조회 중…';\n  try{\n    const response=await workspaceCall('queryRecords',{start:document.getElementById('workspace-query-start').value,end:document.getElementById('workspace-query-end').value,company:document.getElementById('workspace-query-company').value,method:document.getElementById('workspace-query-method').value,search:document.getElementById('workspace-query-search').value,offset});\n    if(!append)area.replaceChildren();\n    response.records.forEach(record=>{\n      const card=workspaceNode('article',undefined,'workspace-card');card.append(workspaceNode('h2',record.date+' · '+record.method),workspaceNode('p',record.company+' · '+record.loc_type+'\\n'+record.qty+' '+record.unit+' · '+Number(record.total_fee||0).toLocaleString()+'원\\n'+record.workers));\n      card.append(workspaceButton('입력 화면에 불러오기',()=>{if(!confirm('현재 입력을 선택한 기록으로 교체할까요? 작업 대기 목록은 유지됩니다.'))return;startEditRecord(record);workspaceSwitch('input');workspacePersist();}));\n      const details=document.createElement('details');details.append(workspaceNode('summary','메모·차량 상세'),workspaceNode('p','메모: '+(record.note||'')+'\\n차량: '+(record.vehicle_no||'')+'\\n주행거리: '+(record.mileage||'')));card.append(details);area.append(card);\n    });\n    area.dataset.offset=offset+response.records.length;status.textContent='전체 '+response.total+'건 · 표시 '+area.children.length+'건';\n    document.getElementById('workspace-query-more').disabled=Number(area.dataset.offset)>=response.total;\n  }catch(error){status.textContent='조회 실패: '+error.message;}\n}\nasync function workspaceInventory(append=false){\n  const area=document.getElementById('workspace-stock-list'),status=document.getElementById('workspace-stock-status');\n  const offset=append?Number(area.dataset.offset||0):0;status.textContent='재고 조회 중…';\n  try{\n    const response=await workspaceCall('getInventory',{search:document.getElementById('workspace-stock-search').value,offset});\n    if(!append)area.replaceChildren();\n    response.records.forEach(row=>{const card=workspaceNode('article',undefined,'workspace-card');card.append(workspaceNode('h2',row.name+(row.model?' · '+row.model:'')),workspaceNode('p',row.company+' / '+row.warehouse+'\\n입고 '+row.incoming+' · 사용 '+row.used+' · 재고 '+row.stock+' '+row.unit+(row.sn?'\\nS/N '+row.sn:'')));area.append(card);});\n    area.dataset.offset=offset+response.records.length;\n    status.textContent='PC 기준 '+(response.generated_at||'미게시')+' · 전체 '+response.total+'건. 실시간 재고가 아니며 모바일 저장 후 PC에서 재집계·게시해야 합니다.'+(response.unassigned_chemicals?' 약품 차감 보류 '+response.unassigned_chemicals+'건 포함.':'');\n    document.getElementById('workspace-stock-more').disabled=Number(area.dataset.offset)>=response.total;\n  }catch(error){status.textContent='조회 실패: '+error.message;}\n}\nasync function workspaceLoadProgress(targetDate){\n  const dateInput=document.getElementById('workspace-progress-date');\n  if(!targetDate && dateInput) targetDate=dateInput.value;\n  if(!targetDate){\n    targetDate=document.getElementById('input-date')?.value || new Date().toISOString().slice(0,10);\n  }\n  if(dateInput) dateInput.value=targetDate;\n\n  const status=document.getElementById('workspace-progress-status');\n  const kpiArea=document.getElementById('workspace-progress-kpi');\n  const tableArea=document.getElementById('workspace-progress-table-wrap');\n  if(status) status.textContent='공정 현황 집계 중…';\n\n  try{\n    const data=await workspaceCall('getProgressSummary',targetDate);\n    if(!data || data.status!=='success') throw new Error((data&&data.detail)||'조회 실패');\n\n    if(status){\n      status.textContent=`기준일: ${data.date}${data.weather?' ('+data.weather+')':''} · PC 작업/감독일보 '1. 작업 물량 및 누계 현황' 실시간 연동`;\n    }\n\n    const note=document.getElementById('workspace-progress-note');\n    if(note){\n      if(data.remarks){\n        note.textContent='📝 비고/특이사항: '+data.remarks;\n        note.hidden=false;\n      }else{\n        note.hidden=true;\n      }\n    }\n\n    if(kpiArea && data.kpi){\n      kpiArea.innerHTML=`\n        <div class=\"progress-kpi-grid\">\n          <div class=\"progress-kpi-card\" style=\"border-left:4px solid #2563eb;\">\n            <div style=\"display:flex;justify-content:space-between;align-items:center;\">\n              <h3>PAUT 공정률</h3>\n              <span style=\"font-size:11px;font-weight:900;color:#1d4ed8;background:#dbeafe;padding:2px 6px;border-radius:6px;\">${data.kpi.paut_rate}%</span>\n            </div>\n            <div class=\"kpi-num\" style=\"color:#1d4ed8;\">${data.kpi.paut_total} <span style=\"font-size:12px;font-weight:normal;color:#64748b;\">M</span></div>\n            <div class=\"kpi-sub\">예상 ${data.kpi.paut_expected}M</div>\n            <div class=\"progress-bar-bg\"><div class=\"progress-bar-fill\" style=\"background:#2563eb;width:${Math.min(100,Math.max(0,Number(data.kpi.paut_rate)))}%;\"></div></div>\n          </div>\n          <div class=\"progress-kpi-card\" style=\"border-left:4px solid #9333ea;\">\n            <div style=\"display:flex;justify-content:space-between;align-items:center;\">\n              <h3>RT 공정률</h3>\n              <span style=\"font-size:11px;font-weight:900;color:#7e22ce;background:#f3e8ff;padding:2px 6px;border-radius:6px;\">${data.kpi.rt_rate}%</span>\n            </div>\n            <div class=\"kpi-num\" style=\"color:#7e22ce;\">${data.kpi.rt_total} <span style=\"font-size:12px;font-weight:normal;color:#64748b;\">매</span></div>\n            <div class=\"kpi-sub\">예상 ${data.kpi.rt_expected}매</div>\n            <div class=\"progress-bar-bg\"><div class=\"progress-bar-fill\" style=\"background:#9333ea;width:${Math.min(100,Math.max(0,Number(data.kpi.rt_rate)))}%;\"></div></div>\n          </div>\n          <div class=\"progress-kpi-card\" style=\"border-left:4px solid #059669;\">\n            <div style=\"display:flex;justify-content:space-between;align-items:center;\">\n              <h3>MT 공정률</h3>\n              <span style=\"font-size:11px;font-weight:900;color:#047857;background:#d1fae5;padding:2px 6px;border-radius:6px;\">${data.kpi.mt_rate}%</span>\n            </div>\n            <div class=\"kpi-num\" style=\"color:#047857;\">${data.kpi.mt_total} <span style=\"font-size:12px;font-weight:normal;color:#64748b;\">P</span></div>\n            <div class=\"kpi-sub\">예상 ${data.kpi.mt_expected}P</div>\n            <div class=\"progress-bar-bg\"><div class=\"progress-bar-fill\" style=\"background:#059669;width:${Math.min(100,Math.max(0,Number(data.kpi.mt_rate)))}%;\"></div></div>\n          </div>\n          <div class=\"progress-kpi-card\" style=\"border-left:4px solid #d97706;\">\n            <div style=\"display:flex;justify-content:space-between;align-items:center;\">\n              <h3>PT 공정률</h3>\n              <span style=\"font-size:11px;font-weight:900;color:#b45309;background:#fef3c7;padding:2px 6px;border-radius:6px;\">${data.kpi.pt_rate}%</span>\n            </div>\n            <div class=\"kpi-num\" style=\"color:#b45309;\">${data.kpi.pt_total} <span style=\"font-size:12px;font-weight:normal;color:#64748b;\">P</span></div>\n            <div class=\"kpi-sub\">예상 ${data.kpi.pt_expected}P</div>\n            <div class=\"progress-bar-bg\"><div class=\"progress-bar-fill\" style=\"background:#d97706;width:${Math.min(100,Math.max(0,Number(data.kpi.pt_rate)))}%;\"></div></div>\n          </div>\n        </div>\n      `;\n    }\n\n    // 2. 기성 정산 요약 및 일별 상세 목록 렌더링\n    const billingArea=document.getElementById('workspace-progress-billing');\n    if(billingArea && data.billing){\n      const b=data.billing;\n      const allBillingRecords=data.billing_records||[];\n      window._currentBillingRecords=allBillingRecords;\n\n      // 시공업체 목록 추출\n      const companies=['전체'];\n      allBillingRecords.forEach(r=>{if(r.company&&!companies.includes(r.company))companies.push(r.company);});\n\n      billingArea.innerHTML=`\n        <div class=\"progress-billing-card\">\n          <div style=\"display:flex;justify-content:space-between;align-items:flex-start;\">\n            <div>\n              <span style=\"font-size:12px;font-weight:800;color:#475569;\">💳 누적 기성 공급가액 (NDT)</span>\n              <div class=\"progress-billing-total\">${Number(b.total_amount||0).toLocaleString()} <span style=\"font-size:14px;font-weight:700;color:#64748b;\">원</span></div>\n            </div>\n            <span style=\"font-size:11px;font-weight:800;background:#dbeafe;color:#1e40af;padding:3px 8px;border-radius:8px;\">PC 일보 연동</span>\n          </div>\n\n          <div class=\"billing-sub-grid\">\n            <div class=\"billing-sub-item\">\n              <div class=\"title\">PAUT 기성 (${Number(b.paut_qty||0).toFixed(4)}M)</div>\n              <div class=\"amount\">${Number(b.paut_amount||0).toLocaleString()}원</div>\n            </div>\n            <div class=\"billing-sub-item\">\n              <div class=\"title\">RT 기성 (${Number(b.rt_qty||0)}매)</div>\n              <div class=\"amount\">${Number(b.rt_amount||0).toLocaleString()}원</div>\n            </div>\n            <div class=\"billing-sub-item\">\n              <div class=\"title\">MT 기성 (${Number(b.mt_qty||0).toFixed(4)}M)</div>\n              <div class=\"amount\">${Number(b.mt_amount||0).toLocaleString()}원</div>\n            </div>\n            <div class=\"billing-sub-item\">\n              <div class=\"title\">PT 기성 (${Number(b.pt_qty||0).toFixed(4)}M)</div>\n              <div class=\"amount\">${Number(b.pt_amount||0).toLocaleString()}원</div>\n            </div>\n          </div>\n\n          <button type=\"button\" id=\"btn-toggle-billing-detail\" class=\"billing-toggle-btn\">\n            ▼ 일별 기성 정산 상세 목록 (${b.records_count}건) 펼치기\n          </button>\n\n          <div id=\"workspace-billing-detail-wrap\" style=\"display:none;margin-top:12px;\">\n            <div style=\"display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;\">\n              <label style=\"font-size:11px;font-weight:700;color:#475569;\">\n                시공업체 필터:\n                <select id=\"select-billing-company-filter\" style=\"padding:4px 8px;border:1px solid #cbd5e1;border-radius:6px;font-size:11px;font-weight:700;margin-left:4px;\">\n                  ${companies.map(c=>`<option value=\"${c}\">${c}</option>`).join('')}\n                </select>\n              </label>\n              <span id=\"billing-filter-count\" style=\"font-size:11px;color:#64748b;\">${allBillingRecords.length}건 표시</span>\n            </div>\n\n            <div class=\"progress-table-wrap\" style=\"max-height:360px;overflow-y:auto;\">\n              <table class=\"progress-table\" id=\"billing-detail-table\">\n                <thead>\n                  <tr>\n                    <th>일자</th>\n                    <th>업체명</th>\n                    <th>구간/위치</th>\n                    <th>종류</th>\n                    <th>형태</th>\n                    <th>자재</th>\n                    <th>실물량</th>\n                    <th>단위</th>\n                    <th>단가</th>\n                    <th>공급가액</th>\n                  </tr>\n                </thead>\n                <tbody id=\"billing-detail-tbody\">\n                </tbody>\n              </table>\n            </div>\n          </div>\n        </div>\n      `;\n\n      function renderBillingTbody(filterComp){\n        const tbody=document.getElementById('billing-detail-tbody');\n        if(!tbody)return;\n        const filtered=filterComp==='전체'?allBillingRecords:allBillingRecords.filter(r=>r.company===filterComp);\n        document.getElementById('billing-filter-count').textContent=filtered.length+'건 표시';\n        tbody.innerHTML=filtered.map(r=>`\n          <tr>\n            <td>${r.date||'-'}</td>\n            <td>${r.company||'-'}</td>\n            <td style=\"max-width:140px;overflow:hidden;text-overflow:ellipsis;\" title=\"${r.loc||''}\">${r.loc||'-'}</td>\n            <td><strong>${r.ndt_type||'-'}</strong></td>\n            <td>${r.work_time||'-'}</td>\n            <td>${r.material_type||'-'}</td>\n            <td>${Number(r.qty||0).toFixed(4)}</td>\n            <td>${r.unit||'M'}</td>\n            <td>${Number(r.unit_price||0).toLocaleString()}</td>\n            <td style=\"font-weight:bold;color:#1e3a8a;\">${Number(r.subtotal||0).toLocaleString()}</td>\n          </tr>\n        `).join('');\n      }\n\n      renderBillingTbody('전체');\n\n      const toggleBtn=document.getElementById('btn-toggle-billing-detail');\n      const detailWrap=document.getElementById('workspace-billing-detail-wrap');\n      if(toggleBtn && detailWrap){\n        toggleBtn.addEventListener('click',()=>{\n          const isHidden=detailWrap.style.display==='none';\n          detailWrap.style.display=isHidden?'block':'none';\n          toggleBtn.textContent=isHidden?`▲ 일별 기성 정산 상세 목록 (${b.records_count}건) 접기`:`▼ 일별 기성 정산 상세 목록 (${b.records_count}건) 펼치기`;\n        });\n      }\n\n      const compSelect=document.getElementById('select-billing-company-filter');\n      if(compSelect){\n        compSelect.addEventListener('change',