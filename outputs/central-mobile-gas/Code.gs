sm.disabled=true;panels.stock.append(sm);\n  const more=workspaceNode('div',undefined,'workspace-card');more.append(workspaceNode('h2','임시저장·이용 안내'),workspaceNode('p','입력 → 작업 목록 확인 → 클라우드 저장 순서로 사용하세요.\\n작성 중 입력과 대기 목록은 이 기기의 브라우저에 보관됩니다. 통신 실패 후 같은 목록을 재저장해도 요청 식별자로 중복 저장을 방지합니다.\\n여러 차량·사진 첨부, 입출고 처리, 기성·예산 편집은 PC에서 진행하세요.'));\n  more.append(workspaceButton('임시 입력 복원',()=>{workspaceRestore(workspaceDraft);workspaceSwitch('input');}),workspaceButton('임시 입력 비우기',()=>{if(!confirm('현재 입력의 임시저장을 지울까요? 대기 목록은 유지됩니다.'))return;workspaceDraft=null;workspaceSkipDraftCapture=true;try{localStorage.setItem(WORKSPACE_STORAGE_KEY,JSON.stringify({pending:workspacePending,draft:null}));}catch(e){}showToast('임시 입력을 비웠습니다.');}));panels.more.append(more);\n  const nav=workspaceNode('nav',undefined,'workspace-nav');nav.setAttribute('aria-label','모바일 업무 메뉴');[['input','입력'],['pending','작업 목록'],['records','기록 조회'],['progress','공정 현황'],['stock','재고'],['more','더보기']].forEach(([page,label])=>{const b=workspaceButton(label,()=>workspaceSwitch(page));b.dataset.page=page;b.setAttribute('aria-selected',String(page==='input'));nav.append(b);});document.body.append(nav);\n  let restoredOnLoad=false;\n  try{const saved=JSON.parse(localStorage.getItem(WORKSPACE_STORAGE_KEY)||'null');if(saved){workspacePending=Array.isArray(saved.pending)?saved.pending:[];workspaceDraft=saved.draft;if(workspaceDraft){workspaceRestore(workspaceDraft);restoredOnLoad=true;showToast('임시 입력을 자동 복원했습니다.');}}}catch(error){workspaceStorageOK=false;}\n  const autoMaterial=()=>{if(manual.checked)manual.checked=false;syncMaterialConnection();workspaceSkipDraftCapture=false;workspacePersist();};\n  document.getElementById('select-material')?.addEventListener('change',autoMaterial);\n  document.getElementById('input-custom-mat')?.addEventListener('input',autoMaterial);\n  document.getElementById('workspace-warehouse')?.addEventListener('change',()=>{syncMaterialConnection();workspaceSkipDraftCapture=false;workspacePersist();});\n  manual.addEventListener('change',()=>{syncMaterialConnection();workspaceSkipDraftCapture=false;workspacePersist();});\n  document.getElementById('workspace-material-id')?.addEventListener('change',()=>{manual.checked=true;syncMaterialConnection();workspaceSkipDraftCapture=false;workspacePersist();});\n  input.addEventListener('input',()=>{workspaceSkipDraftCapture=false;clearTimeout(workspaceTimer);workspaceTimer=setTimeout(workspacePersist,350);});input.addEventListener('change',()=>{workspaceSkipDraftCapture=false;workspacePersist();});\n  window.addEventListener('beforeunload',e=>{workspacePersist();if(workspacePending.length||!workspaceStorageOK){e.preventDefault();e.returnValue='';}});\n  window.addEventListener('online',()=>showToast('통신이 연결되었습니다. 작업 목록에서 저장을 다시 눌러 주세요.'));\n  workspaceRenderPending();status.textContent=workspaceStorageOK?(restoredOnLoad?'이 기기의 임시 입력을 자동 복원했습니다.':'이 기기에 임시저장됩니다. 클라우드 저장은 작업 목록에서 완료하세요.'):'임시저장을 사용할 수 없습니다. 화면을 닫기 전에 클라우드에 저장하세요.';\n})();\n</script>\n\n</body>\n\n</html>";
