nd(input);\n  const status=workspaceNode('p',undefined,'workspace-status');status.id='workspace-local-status';input.prepend(status);\n  const warehouseWrap=workspaceNode('div',undefined,'workspace-card');warehouseWrap.id='workspace-warehouse-wrap';warehouseWrap.hidden=true;\n  warehouseWrap.append(workspaceNode('h2','동일 자재의 창고 선택'));\n  const warehouseFields=workspaceNode('div',undefined,'workspace-filters');warehouseWrap.append(warehouseFields);\n  workspaceFilter(warehouseFields,'workspace-warehouse','창고 · 품목','text',[['','창고·품목을 선택하세요']]);\n  warehouseWrap.append(workspaceNode('p','같은 자재가 여러 창고에 있어 출고 기준 품목을 선택해야 합니다.','workspace-status'));\n  input.insertBefore(warehouseWrap,input.lastElementChild);\n\n  const mapping=document.createElement('details');mapping.className='workspace-card';mapping.style.gridColumn='1 / -1';\n  mapping.append(workspaceNode('summary','고급 설정 · 재고 수동 연결'));\n  const manualLabel=workspaceNode('label',undefined,'workspace-check');\n  const manual=document.createElement('input');manual.type='checkbox';manual.id='workspace-manual-link';\n  manualLabel.append(manual,workspaceNode('span','자동 연결을 사용하지 않고 품목을 직접 지정'));\n  mapping.append(manualLabel);\n  const mappingFields=workspaceNode('div',undefined,'workspace-filters');mappingFields.id='workspace-manual-fields';mappingFields.hidden=true;mapping.append(mappingFields);\n  workspaceFilter(mappingFields,'workspace-material-id','품목 · 모델 · 창고','text',[['','연결 안 함']]);\n  mapping.append(workspaceNode('p','일반 입력에서는 자재 선택에 따라 자동 연결됩니다. 기존 기록 복원이나 예외 품목에만 사용하세요.','workspace-status'));\n  input.insertBefore(mapping,input.lastElementChild);\n  refreshMethodChoices(selectedMethod);\n  const methodBar=document.querySelector('.method-btn').parentElement;\n  if(!document.querySelector('.method-btn[data-method=\"UT\"]')){const ut=workspaceButton('UT',()=>switchMethod('UT'));ut.className='method-btn py-2 text-xs font-bold rounded-lg text-slate-600';ut.dataset.method='UT';methodBar.append(ut);}methodBar.style