{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "롯데건설 바이오로직스 실행 (독립 창)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}\\home\\src\\롯데건설 바이오로직스.py",
            "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "cwd": "${workspaceFolder}\\home\\src",
            "console": "externalTerminal",
            "justMyCode": true
        },
        {
            "name": "롯데건설 앱 실행 (site_apps/lotte)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}\\home\\src\\site_apps\\lotte\\main.py",
            "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "cwd": "${workspaceFolder}\\home\\src",
            "console": "externalTerminal",
            "justMyCode": true
        },
        {
            "name": "중앙지사 앱 실행 (독립 창)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}\\home\\src\\site_apps\\central\\main.py",
            "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "cwd": "${workspaceFolder}\\home\\src",
            "console": "externalTerminal",
            "justMyCode": true
        },
        {
            "name": "한국가스공사 앱 실행 (독립 창)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}\\home\\src\\site_apps\\kogas\\main.py",
            "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "cwd": "${workspaceFolder}\\home\\src",
            "console": "externalTerminal",
            "justMyCode": true
        },
        {
            "name": "RT 필름 영상화 정리기 (Run/Debug)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}\\rt_film_organizer\\desktop_app.py",
            "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "cwd": "${workspaceFolder}\\rt_film_organizer",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONUTF8": "1"
            }
        }
    ]
}
